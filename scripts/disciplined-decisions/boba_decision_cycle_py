def call_boba_llm(setup_data):
    api_key = core.read_secret('anthropic.key') or os.getenv('ANTHROPIC_API_KEY', '')
    if not api_key:
        return deterministic_decision(setup_data)
    prompt = f"""You are Boba running a disciplined $1,000 capital experiment on Alpaca paper.

CAPITAL DISCIPLINE - READ EVERY TIME:
- Total account = $1,000. ONE option position at a time. Position sizing already determined by upstream code (50-80% deploy based on grade).
- Initial stop = entry * 0.95 (-5%) submitted automatically after fill.
- Trail = stop ratchets up to peak * 0.95 every time the option price makes a new high. Stop never moves down.
- No take-profit target. Exit happens only when stop hits OR you decide via SKIP next cycle.
- Cycles run every 30 minutes. You will see this exact same setup again if you pick WAIT_FOR_PULLBACK.

YOUR JOB: classify this single setup into ENTER_NOW, WAIT_FOR_PULLBACK, or SKIP.
- ENTER_NOW: setup is clean RIGHT NOW. Strong technicals, no obvious red flag, willing to risk 5% to chase the trend.
- WAIT_FOR_PULLBACK: setup is okay but price extended/RSI overbought/just spiked - want a better entry within next 60-90 min.
- SKIP: thesis is broken or setup is too weak. Do not enter even later today.

CONSTRAINTS:
- ONLY $1,000 to work with. Each trade is precious. A bad entry burns 50-80% of your capital.
- Better to skip than force a marginal trade. Patience beats activity.
- A+ grade = 3+ scanner confluence on T1 huge flow. A grade = 2 confluence on T2 unusual.

Setup data:
{json.dumps(setup_data, indent=2)}

Output JSON only: {{"decision": "ENTER_NOW|WAIT_FOR_PULLBACK|SKIP", "reason": "one sentence concrete reasoning", "confidence": 0.0-1.0}}"""
    try:
        r = requests.post('https://api.anthropic.com/v1/messages',
            headers={'x-api-key': api_key, 'anthropic-version': '2023-06-01', 'content-type': 'application/json'},
            json={'model': 'claude-sonnet-4-20250514', 'max_tokens': 300, 'messages': [{'role': 'user', 'content': prompt}]},
            timeout=30)
        if r.status_code != 200:
            return deterministic_decision(setup_data)
        text = r.json()['content'][0]['text']
        s, e = text.find('{'), text.rfind('}')
        if s >= 0 and e > s:
            return json.loads(text[s:e+1])
    except Exception:
        pass
    return deterministic_decision(setup_data)


def deterministic_decision(setup_data):
    ta = setup_data.get('ta', {})
    pe9 = ta.get('price_vs_ema9', 0)
    rsi = ta.get('rsi', 50)
    if not setup_data.get('is_put', False):
        if pe9 < -2 and 30 <= rsi <= 50:
            return {'decision': 'ENTER_NOW', 'reason': 'call pullback to EMA9 healthy RSI', 'confidence': 0.7}
        elif pe9 > 3 and rsi > 70:
            return {'decision': 'WAIT_FOR_PULLBACK', 'reason': 'extended overbought', 'confidence': 0.6}
    else:
        if pe9 > 2 and 50 <= rsi <= 70:
            return {'decision': 'ENTER_NOW', 'reason': 'put rally healthy', 'confidence': 0.7}
    return {'decision': 'WAIT_FOR_PULLBACK', 'reason': 'no clean signal', 'confidence': 0.5}


def submit_order(occ, qty, limit, stop, tp, key, secret, dry_run):
    """Two-step pattern - limit buy, poll fill, then stop_limit SL with sell_to_close."""
    import time as _t
    buy_payload = {
        'symbol': occ, 'qty': str(qty), 'side': 'buy', 'type': 'limit', 'time_in_force': 'day',
        'limit_price': str(round(limit, 2)),
    }
    log.info(f'  ORDER {"DRY " if dry_run else ""}{occ} qty={qty} limit=${limit:.2f} stop=${stop:.2f} TP=${tp:.2f}')
    if dry_run:
        return {'dry_run': True, 'payload': buy_payload}
    
    buy_resp = core.alpaca_call('/v2/orders', key, secret, method='POST', json=buy_payload)
    if not buy_resp or not buy_resp.get('id'):
        log.error('    BUY submission failed')
        return None
    buy_id = buy_resp['id']
    log.info(f'    BUY submitted id={buy_id[:12]}... waiting for fill')
    
    fill_price = None
    for i in range(20):
        _t.sleep(0.5)
        poll = core.alpaca_call(f'/v2/orders/{buy_id}', key, secret)
        if poll and poll.get('status') == 'filled':
            fill_price = float(poll.get('filled_avg_price') or 0)
            log.info(f'    FILLED at ${fill_price:.2f}')
            break
        elif poll and poll.get('status') in ('canceled', 'rejected', 'expired'):
            log.warning(f'    BUY {poll.get("status")}, no SL armed')
            return buy_resp
    
    if not fill_price:
        log.info(f'    BUY pending - SL will be armed by trail_daemon when position appears')
        return buy_resp
    
    stop_trigger = round(max(fill_price * 0.95, 0.01), 2)
    stop_limit_p = round(max(stop_trigger * 0.90, 0.01), 2)
    sl_payload = {
        'symbol': occ, 'qty': str(qty), 'side': 'sell',
        'type': 'stop_limit', 'time_in_force': 'gtc',
        'stop_price': str(stop_trigger), 'limit_price': str(stop_limit_p),
        'position_intent': 'sell_to_close',
    }
    sl_resp = core.alpaca_call('/v2/orders', key, secret, method='POST', json=sl_payload)
    if sl_resp and sl_resp.get('id'):
        log.info(f'    SL ARMED stop=${stop_trigger:.2f} limit=${stop_limit_p:.2f}')
    else:
        log.warning(f'    SL submit failed - trail_daemon will retry')
    
    return buy_resp


def post_discord(setup, decision, dry_run):
    sym = setup['symbol']
    grade = setup.get('grade')
    occ = setup.get('occ')
    rsn = decision.get('reason', '')
    conf = decision.get('confidence', 0)
    dec = decision.get('decision', 'SKIP')
    emoji = {'ENTER_NOW': '🟢', 'WAIT_FOR_PULLBACK': '🟡', 'SKIP': '🔴'}.get(dec, '⚪')
    msg = (
        f"{'🧪 DRY ' if dry_run else ''}**Boba** {emoji}\n"
        f"**{sym}** ({occ}) Grade **{grade}** Tier {setup.get('tier')}\n"
        f"Confluence: {setup.get('confluence_count')} scanners\n"
        f"TA: RSI {setup.get('ta',{}).get('rsi')}, EMA9 dev {setup.get('ta',{}).get('price_vs_ema9')}%\n"
        f"→ **{dec}** ({conf:.0%}): {rsn}"
    )
    try:
        requests.post(WEBHOOK, json={'content': msg[:1900]}, timeout=10)
    except Exception:
        pass


def append_log(setup, decision, dry_run):
    DECISION_LOG.parent.mkdir(parents=True, exist_ok=True)
    entry = {
        'ts': datetime.now(timezone.utc).isoformat(),
        'agent': 'boba', 'dry_run': dry_run,
        'symbol': setup.get('symbol'), 'occ': setup.get('occ'),
        'grade': setup.get('grade'), 'tier': setup.get('tier'),
        'confluence': setup.get('confluence'),
        'flow_value': setup.get('flow_value'),
        'ta': setup.get('ta'),
        'option_quote': setup.get('option_quote'),
        'decision': decision,
    }
    with DECISION_LOG.open('a') as f:
        f.write(json.dumps(entry) + '\n')


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args()
    log.info(f'=== boba cycle (dry_run={args.dry_run}) ===')

    bk, bs = core.read_secret('alpaca-boba-key-id'), core.read_secret('alpaca-boba-secret')
    if not bk or not bs:
        log.error('boba keys missing')
        return

    account = core.get_account_state(bk, bs)
    if not account:
        log.error('cannot read account state')
        return
    cash = float(account.get('cash', 0))
    equity = float(account.get('equity', 0))
    log.info(f'boba equity ${equity:.2f} cash ${cash:.2f}')
    killswitch = Path(f'/home/ubuntu/.openclaw/workspace/state/disciplined/boba_killswitch')
    if killswitch.exists():
        log.warning(f'CIRCUIT BREAKER TRIPPED - skipping cycle')
        return

    if len(core.get_open_positions(bk, bs)) >= core.HARD_CAP_OPEN_POSITIONS:
        log.info('open position cap reached, skip')
        return

    candidates = core.fetch_active_flow()
    log.info(f'flow candidates: {len(candidates)}')
    if not candidates:
        return

    scored = core.filter_and_score_candidates(candidates, sort_strategy='boba')
    log.info(f'after confluence filter: {len(scored)}')
    if not scored:
        return

    other_picks = core.get_other_agents_occ_today('boba')
    pre_skip = len(scored)
    scored = [s for s in scored if s['occ'] not in other_picks]
    log.info(f'after cross-agent skip: {len(scored)}')
    skipped_count = pre_skip - len(scored)
    if skipped_count > 0:
        try:
            requests.post(WEBHOOK, json={'content': f'🤝 **Boba** skipped {skipped_count} OCC(s) already picked by Jazzy today'}, timeout=10)
        except Exception:
            pass
    if not scored:
        log.info('no candidates left after skipping other agents picks, skip')
        return

    best = scored[0]
    log.info(f'pick: {best["symbol"]} {best["occ"]} grade {best["grade"]}')
    best['ta'] = core.fetch_inline_ta(best['symbol'], bk, bs)
    best['option_quote'] = core.fetch_tradier_quote(best['occ'])
    if best['option_quote']:
        sp = best['option_quote'].get('spread_pct', 100)
        if sp > core.MAX_BIDASK_SPREAD_PCT:
            log.info(f'spread {sp}% too wide, skip')
            return

    decision = call_boba_llm(best)
    log.info(f'decision: {decision}')
    append_log(best, decision, args.dry_run)
    post_discord(best, decision, args.dry_run)

    if decision.get('decision') == 'ENTER_NOW':
        if not best.get('option_quote'):
            return
        ask = best['option_quote']['ask']
        if ask <= 0:
            return
        deploy = cash * best['sizing_pct']
        qty = max(1, int(deploy / (ask * 100)))
        qty = min(qty, 3)
        if qty * ask * 100 > cash * 0.95:
            qty = max(1, int(cash * 0.95 / (ask * 100)))
        if qty < 1:
            log.info(f'cant afford 1 contract at ${ask:.2f}')
            return
        stop_p = round(ask * 0.95, 2)  # uniform 5 pct initial stop applies trail logic from entry
        tp_p = round(ask * 2.0, 2)
        result = submit_order(best['occ'], qty, ask, stop_p, tp_p, bk, bs, args.dry_run)
        log.info(f'result: {json.dumps(result)[:300] if result else "FAIL"}')
        # Record pick AFTER successful submit (or in dry-run)
        if result:
            core.record_agent_pick('boba', best['occ'])
    log.info('=== done ===')


if __name__ == '__main__':
    main()
