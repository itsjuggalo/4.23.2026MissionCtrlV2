#!/usr/bin/env python3
"""
morning_status - Pre-market briefing post to TradeFlow Discord.
Fires at 9:25 AM ET Mon-Fri showing:
  - Both account states (equity, cash, positions)
  - Recent flow alert count + top 3 by value
  - Scanner freshness summary
  - LLM provider status
"""
import json, sys, time, requests
from datetime import datetime
from pathlib import Path

sys.path.insert(0, '/home/ubuntu/scripts/disciplined-decisions')
import core

WEBHOOK = 'https://discordapp.com/api/webhooks/1497661681126609008/tlS_qnTSq4Uef8AUVpllp2vwC3sJ7u0BHt2_WcoJz5y75dnh3cgHpkhOn59zGlkWmyPk'


def get_account_summary(name, key_file, secret_file):
    key = core.read_secret(key_file)
    secret = core.read_secret(secret_file)
    if not key or not secret:
        return f'  {name}: ❌ keys missing'
    acct = core.get_account_state(key, secret)
    if not acct:
        return f'  {name}: ❌ account read failed'
    equity = float(acct.get('equity', 0))
    cash = float(acct.get('cash', 0))
    positions = core.get_open_positions(key, secret) or []
    pos_str = f'{len(positions)} pos' if positions else 'no positions'
    return f'  {name}: ${equity:,.2f} equity ({pos_str})'


def main():
    et_now = datetime.now().astimezone()
    
    boba_line = get_account_summary('Boba R1', 'alpaca-boba-key-id', 'alpaca-boba-secret')
    jazzy_line = get_account_summary('Jazzy R1', 'alpaca-jazzy-key-id', 'alpaca-jazzy-secret')
    
    candidates = core.fetch_active_flow()
    cand_count = len(candidates)
    top_3 = sorted(candidates, key=lambda x: -x.get('flow_value', 0))[:3] if candidates else []
    
    SCANNER_DIR = Path('/home/ubuntu/.openclaw/data/scanners')
    fresh_scanners = sum(1 for p in SCANNER_DIR.glob('*.json') 
                         if 'state' not in p.name and (time.time() - p.stat().st_mtime) < 4*3600)
    total_scanners = sum(1 for p in SCANNER_DIR.glob('*.json') if 'state' not in p.name)
    
    msg_lines = [
        f"☀️ **MORNING STATUS** — {et_now.strftime('%Y-%m-%d %H:%M ET')}",
        f"",
        f"**Accounts**",
        boba_line,
        jazzy_line,
        f"",
        f"**Flow Candidates**: {cand_count} setups passing T1/T2 hard filter",
    ]
    if top_3:
        msg_lines.append(f"")
        msg_lines.append(f"**Top 3 by flow value**:")
        for c in top_3:
            t = c.get('tier')
            v = c.get('flow_value', 0)
            ud = 'PUT' if c.get('is_put') else 'CALL'
            msg_lines.append(f"  • {c.get('symbol')} {t} ${v:,.0f} {ud} DTE {c.get('dte')}")
    msg_lines.extend([
        f"",
        f"**Scanners**: {fresh_scanners}/{total_scanners} fresh (<4h)",
        f"",
        f"Decision cycles begin at 9:30 AM ET. Trail daemon polling every minute.",
    ])
    
    msg = '\n'.join(msg_lines)
    try:
        r = requests.post(WEBHOOK, json={'content': msg[:1900]}, timeout=10)
        print(f'  posted morning status HTTP {r.status_code}')
    except Exception as e:
        print(f'  Discord post failed: {e}')


if __name__ == '__main__':
    main()
