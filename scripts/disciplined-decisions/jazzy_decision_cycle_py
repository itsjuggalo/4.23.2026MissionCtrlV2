#!/usr/bin/env python3
"""
jazzy_decision_cycle - Disciplined 1K JazzyHazzy paper account.
Sort strategy: confluence DESC first (highest agreement), then T1 over T2, then freshest signal.
Cross-coordinates with boba via shared state file - skips OCCs boba already picked today.
LLM: GPT-4o-mini.
"""
import argparse, json, logging, sys, os
from datetime import datetime, timezone
from pathlib import Path
import requests

sys.path.insert(0, '/home/ubuntu/scripts/disciplined-decisions')
import core

logging.basicConfig(level=logging.INFO, format='%(asctime)s [jazzy] %(message)s', datefmt='%H:%M:%S')
log = logging.getLogger('jazzy')

WEBHOOK = 'https://discordapp.com/api/webhooks/1497661681126609008/tlS_qnTSq4Uef8AUVpllp2vwC3sJ7u0BHt2_WcoJz5y75dnh3cgHpkhOn59zGlkWmyPk'
DECISION_LOG = Path('/home/ubuntu/.openclaw/workspace/logs/jazzy_decisions_jsonl')


def call_jazzy_llm(setup_data):
    api_key = core.read_secret('openai.key') or os.getenv('OPENAI_API_KEY', '')
    if not api_key:
        return deterministic_decision(setup_data)
    prompt = f"""You are JazzyHazzy running disciplined 1K experiment.
ONE position at a time. -10% stop on A+, -20% on A. Trail to BE at +20%.
You favor highest scanner agreement over largest flow.
Setup: {json.dumps(setup_data, indent=2)}
Output JSON only: {{"decision": "ENTER_NOW|WAIT_FOR_PULLBACK|SKIP", "reason": "one sentence", "confidence": 0.0-1.0}}"""
    try:
        r = requests.post('https://api.openai.com/v1/chat/completions',
            headers={'Authorization': f'Bearer {api_key}', 'Content-Type': 'application/json'},
            json={'model': 'gpt-4o-mini', 'max_tokens': 300, 'messages': [{'role': 'user', 'content': prompt}]},
            timeout=30)
        if r.status_code != 200:
            return deterministic_decision(setup_data)
        text = r.json()['choices'][0]['message']['content']
        s, e = text.find('{'), text.rfind('}')
        if s >= 0 and e > s:
            return json.loads(text[s:e+1])
    except Exception:
        pass
    return deterministic_decision(setup_data)


def deterministic_decision(setup_data):
    ta = setup_data.get('ta', {})
    pe9 = ta.get('price_vs_ema9', 0)
    rsi = ta.get('rsi', 50)
    bb_pos = ta.get('bb_position', 0.5)
    is_call = not setup_data.get('is_put', False)
    if is_call:
        if bb_pos < 0.4 and 35 <= rsi <= 55:
            return {'decision': 'ENTER_NOW', 'reason': 'call near lower BB clean RSI', 'confidence': 0.7}
        elif rsi > 75:
            return {'decision': 'SKIP', 'reason': 'RSI too high', 'confidence': 0.6}
    else:
        if bb_pos > 0.6 and 45 <= rsi <= 65:
            return {'decision': 'ENTER_NOW', 'reason': 'put near upper BB clean RSI', 'confidence': 0.7}
    return {'decision': 'WAIT_FOR_PULLBACK', 'reason': 'waiting for cleaner setup', 'confidence': 0.5}


def submit_order(occ, qty, limit, stop, tp, key, secret, dry_run):
    # Options do not support bracket on Alpaca paper - submit simple limit buy
    # Trail daemon adds OCO close once position is detected
    payload = {
        'symbol': occ, 'qty': str(qty), 'side': 'buy', 'type': 'limit', 'time_in_force': 'day',
        'limit_price': str(round(limit, 2)),
    }
    log.info(f'  ORDER {"DRY " if dry_run else ""}{occ} qty={qty} limit=${limit:.2f} stop=${stop:.2f} TP=${tp:.2f}')
    if dry_run:
        return {'dry_run': True, 'payload': payload}
    return core.alpaca_call('/v2/orders', key, secret, method='POST', json=payload)


def post_discord(setup, decision, dry_run):
    sym = setup['symbol']
    grade = setup.get('grade')
    occ = setup.get('occ')
    rsn = decision.get('reason', '')
    conf = decision.get('confidence', 0)
    dec = decision.get('decision', 'SKIP')
    emoji = {'ENTER_NOW': '🟢', 'WAIT_FOR_PULLBACK': '🟡', 'SKIP': '🔴'}.get(dec, '⚪')
    msg = (
        f"{'🧪 DRY ' if dry_run else ''}**Jazzy** {emoji}\n"
        f"**{sym}** ({occ}) Grade **{grade}** Tier {setup.get('tier')}\n"
        f"Confluence: {setup.get('confluence_count')} scanners\n"
        f"TA: RSI {setup.get('ta',{}).get('rsi')}, BB pos {setup.get('ta',{}).get('bb_position')}\n"
        f"→ **{dec}** ({conf:.0%}): {rsn}"
    )
    try:
        requests.post(WEBHOOK, json={'content': msg[:1900]}, timeout=10)
    except Exception:
        pass


def append_log(setup, decision, dry_run):
    DECISION_LOG.parent.mkdir(parents=True, exist_ok=True)
    entry = {
        'ts': datetime.now(timezone.utc).isoformat(),
        'agent': 'jazzy', 'dry_run': dry_run,
        'symbol': setup.get('symbol'), 'occ': setup.get('occ'),
        'grade': setup.get('grade'), 'tier': setup.get('tier'),
        'confluence': setup.get('confluence'),
        'flow_value': setup.get('flow_value'),
        'ta': setup.get('ta'),
        'option_quote': setup.get('option_quote'),
        'decision': decision,
    }
    with DECISION_LOG.open('a') as f:
        f.write(json.dumps(entry) + '\n')


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args()
    log.info(f'=== jazzy cycle (dry_run={args.dry_run}) ===')

    jk, js = core.read_secret('alpaca-jazzy-key-id'), core.read_secret('alpaca-jazzy-secret')
    if not jk or not js:
        log.error('jazzy keys missing')
        return

    account = core.get_account_state(jk, js)
    if not account:
        log.error('cannot read account state')
        return
    cash = float(account.get('cash', 0))
    equity = float(account.get('equity', 0))
    log.info(f'jazzy equity ${equity:.2f} cash ${cash:.2f}')

    if len(core.get_open_positions(jk, js)) >= core.HARD_CAP_OPEN_POSITIONS:
        log.info('open position cap reached, skip')
        return

    candidates = core.fetch_active_flow()
    log.info(f'flow candidates: {len(candidates)}')
    if not candidates:
        return

    scored = core.filter_and_score_candidates(candidates, sort_strategy='jazzy')
    log.info(f'after confluence filter: {len(scored)}')
    if not scored:
        return

    other_picks = core.get_other_agents_occ_today('jazzy')
    scored = [s for s in scored if s['occ'] not in other_picks]
    log.info(f'after cross-agent skip: {len(scored)}')
    if not scored:
        log.info('no candidates left after skipping boba picks, skip')
        return

    best = scored[0]
    log.info(f'pick: {best["symbol"]} {best["occ"]} grade {best["grade"]}')
    best['ta'] = core.fetch_inline_ta(best['symbol'], jk, js)
    best['option_quote'] = core.fetch_tradier_quote(best['occ'])
    if best['option_quote']:
        sp = best['option_quote'].get('spread_pct', 100)
        if sp > core.MAX_BIDASK_SPREAD_PCT:
            log.info(f'spread {sp}% too wide, skip')
            return

    decision = call_jazzy_llm(best)
    log.info(f'decision: {decision}')
    append_log(best, decision, args.dry_run)
    post_discord(best, decision, args.dry_run)

    if decision.get('decision') == 'ENTER_NOW':
        if not best.get('option_quote'):
            return
        ask = best['option_quote']['ask']
        if ask <= 0:
            return
        deploy = cash * best['sizing_pct']
        qty = max(1, int(deploy / (ask * 100)))
        qty = min(qty, 3)
        if qty * ask * 100 > cash * 0.95:
            qty = max(1, int(cash * 0.95 / (ask * 100)))
        if qty < 1:
            log.info(f'cant afford 1 contract at ${ask:.2f}')
            return
        stop_p = round(ask * 0.95, 2)  # uniform 5 pct initial stop applies trail logic from entry
        tp_p = round(ask * 2.0, 2)
        result = submit_order(best['occ'], qty, ask, stop_p, tp_p, jk, js, args.dry_run)
        log.info(f'result: {json.dumps(result)[:300] if result else "FAIL"}')
        if result:
            core.record_agent_pick('jazzy', best['occ'])
    log.info('=== done ===')


if __name__ == '__main__':
    main()
