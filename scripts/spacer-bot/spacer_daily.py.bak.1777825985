#!/usr/bin/env python3
"""
Spacer Daily v3 — dual-pass divider poster.

Modes:
  --pass=eod       Posts EOD CLOSED divider (run 11:59 PM ET).
                   ▲ today (just-closed) ◆ CLOSED ◆ tomorrow (next session) ▼

  --pass=morning   Posts MORNING OPEN divider (run 12:05 AM ET).
                   ▲ yesterday ◆ OPEN ◆ today ▼

Both passes use the flourish frame with sun (☀ morning) / moon (☾ EOD) symbols.
Cycles through 18 base styles by day-of-year for the line accent.

Cron entries (TZ=America/New_York):
  59 23 * * * /usr/bin/python3 /home/ubuntu/scripts/spacer-bot/spacer_daily.py --pass=eod
   5  0 * * * /usr/bin/python3 /home/ubuntu/scripts/spacer-bot/spacer_daily.py --pass=morning

State guard prevents duplicates per-channel-per-pass-per-date on cron retries.
"""
import argparse
import json
import logging
import sys
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

import requests

SECRETS = Path("/home/ubuntu/.openclaw/secrets")
STATE = Path("/home/ubuntu/.openclaw/workspace/state/spacer_daily_state.json")
LOG_DIR = Path("/home/ubuntu/.openclaw/workspace/logs")
LOG_DIR.mkdir(parents=True, exist_ok=True)
STATE.parent.mkdir(parents=True, exist_ok=True)

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
    handlers=[logging.FileHandler(LOG_DIR / "spacer_daily.log"), logging.StreamHandler()],
)
log = logging.getLogger("spacer_daily")

TOKEN = (SECRETS / "spacer_bot_token.txt").read_text().strip()
CHANNEL_LIST_FILE = SECRETS / "spacer_daily_channels"

# 18 line accents -- cycled by day-of-year for variety on the top/bottom bars.
LINE_ACCENTS = [
    "─", "━", "═", "▬", "▭", "▱",
    "┄", "┅", "┈", "┉", "╌", "╍",
    "─", "━", "═", "▬", "─", "━",
]


def fmt_date(dt: datetime) -> str:
    """Format datetime as 'Mon May 5' (no leading zero on day)."""
    return dt.strftime("%a %b ") + str(dt.day)


def build_divider(pass_name: str, today: datetime, doy: int) -> str:
    """Build the cool dual-arrow divider for the given pass."""
    accent = LINE_ACCENTS[doy % len(LINE_ACCENTS)]
    bar = accent * 7
    if pass_name == "morning":
        # Morning: ▲ yesterday  ◆ OPEN ◆  today ▼
        sym = "☀"
        prior = today - timedelta(days=1)
        next_ = today
        label = "OPEN"
    else:
        # EOD: ▲ today  ◆ CLOSED ◆  tomorrow ▼
        sym = "☾"
        prior = today
        next_ = today + timedelta(days=1)
        label = "CLOSED"

    top = f"        ╭───────⊰  {sym}  ⊱───────╮"
    mid = f"   ▲ {fmt_date(prior)}  ◆  {label}  ◆  {fmt_date(next_)} ▼"
    bot = f"        ╰───────⊰  {sym}  ⊱───────╯"
    return f"{top}\n{mid}\n{bot}"


def load_channels() -> list:
    if not CHANNEL_LIST_FILE.exists():
        log.error(f"channel list not found: {CHANNEL_LIST_FILE}")
        return []
    chans = []
    for line in CHANNEL_LIST_FILE.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        cid = line.split("#")[0].strip().split()[0]
        if cid.isdigit():
            chans.append(int(cid))
    return chans


def load_state() -> dict:
    if not STATE.exists():
        return {}
    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {}


def save_state(state: dict):
    STATE.write_text(json.dumps(state, indent=2))


def post_divider(channel_id: int, message: str) -> bool:
    url = f"https://discord.com/api/v10/channels/{channel_id}/messages"
    headers = {"Authorization": f"Bot {TOKEN}", "Content-Type": "application/json"}
    try:
        r = requests.post(url, headers=headers, json={"content": message}, timeout=15)
        if r.status_code in (200, 201):
            return True
        log.error(f"channel {channel_id} post fail: {r.status_code} {r.text[:200]}")
        return False
    except Exception as e:
        log.error(f"channel {channel_id} exception: {e}")
        return False


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--pass", dest="pass_name", choices=["eod", "morning"], required=True)
    args = parser.parse_args()

    et_now = datetime.now(ZoneInfo("America/New_York"))
    today = et_now.replace(hour=0, minute=0, second=0, microsecond=0)
    today_str = today.strftime("%Y-%m-%d")
    doy = et_now.timetuple().tm_yday

    log.info(f"=== spacer_daily {today_str} pass={args.pass_name} (DOY {doy}) ===")

    channels = load_channels()
    if not channels:
        log.error("no channels configured, exiting")
        return

    message = build_divider(args.pass_name, today, doy)
    log.info(f"divider preview:\n{message}")

    state = load_state()
    state_key_prefix = f"{today_str}_{args.pass_name}"

    posted = 0
    skipped = 0
    failed = 0
    for cid in channels:
        guard_key = f"{cid}_{state_key_prefix}"
        if state.get(guard_key) == "done":
            skipped += 1
            log.info(f"  channel {cid}: already posted {args.pass_name} today, skip")
            continue
        ok = post_divider(cid, message)
        if ok:
            state[guard_key] = "done"
            posted += 1
            log.info(f"  channel {cid}: ✓ posted {args.pass_name}")
            time.sleep(0.5)
        else:
            failed += 1

    # Garbage-collect state entries older than 7 days
    cutoff = (today - timedelta(days=7)).strftime("%Y-%m-%d")
    state = {k: v for k, v in state.items() if k.split("_", 1)[1] >= cutoff or "_" not in k.split("_", 1)[1]}
    save_state(state)
    log.info(f"=== done pass={args.pass_name}: {posted} posted, {skipped} skipped, {failed} failed ===")


if __name__ == "__main__":
    main()
