#!/usr/bin/env python3
"""
GitHub Pine Script auto-scout - Item 36.

Weekly cron searches GitHub for Pine strategy repos updated recently with
star traction, posts top candidates to Discord pattern-alerts for Mike to
review and queue into the Pine build pipeline.

Filters:
  - language:Pine (TradingView Pine Script v4/v5/v6)
  - stars >= MIN_STARS (community validation signal)
  - pushed within last 60 days (active development)
  - not already seen (state-tracked)
  - description doesn't match noise terms (just-an-indicator, learning, tutorial)

Posts top 5 NEW candidates per run with name/stars/last-push/desc/URL.

Source: https://api.github.com/search/repositories
Auth: ~/.openclaw/secrets/github.key (5000/hr rate limit)
State: openclaw/state/github_scout/seen_repos.json
Discord: discord_pattern_alerts_webhook

Cron: weekly Sun 10pm ET (UTC Mon 02:00).
"""
import json
import os
import sys
import time
import urllib.parse
import urllib.request
from datetime import datetime, timezone, timedelta
from pathlib import Path

SECRETS = Path("/home/ubuntu/.openclaw/secrets")
TOKEN_FILE = SECRETS / "github.key"
WEBHOOK_FILE = SECRETS / "discord_pattern_alerts_webhook"
STATE_DIR = Path("/home/ubuntu/.openclaw/state/github_scout")
STATE_FILE = STATE_DIR / "seen_repos.json"
LOG_FILE = STATE_DIR / "scout_log.jsonl"

USER_AGENT = "MissionCtrl-PineScout/1.0"

MIN_STARS = 5
PUSHED_WITHIN_DAYS = 60
TOP_N_TO_POST = 5

# Noise filter - skip repos whose name or description matches these
# (these are usually tutorial/learning content, not strategies)
NOISE_TERMS = (
    "tutorial", "course", "learn pine", "pine basics",
    "indicator only", "just-indicator", "demo", "example",
    "test pine", "playground",
)


def load_token():
    if not TOKEN_FILE.exists():
        return None
    return TOKEN_FILE.read_text().strip()


def load_seen():
    if STATE_FILE.exists():
        try:
            return set(json.loads(STATE_FILE.read_text()))
        except Exception:
            pass
    return set()


def save_seen(s):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(sorted(list(s))))


def append_log(rec):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a") as f:
        f.write(json.dumps(rec) + "\n")


def search_pine_repos():
    """Returns list of repo dicts matching filter criteria.

    GitHub's language: qualifier is unreliable for multi-word names like Pine Script.
    Strategy: query by topics that Pine devs tag (tradingview, pinescript, pine-script),
    then client-side filter results where language field == "Pine Script".
    """
    token = load_token()
    cutoff = (datetime.now(timezone.utc) - timedelta(days=PUSHED_WITHIN_DAYS)).strftime("%Y-%m-%d")
    # Combine three topic variants to maximize coverage
    q = f"topic:tradingview topic:pinescript stars:>={MIN_STARS} pushed:>{cutoff}"
    url = f"https://api.github.com/search/repositories?q={urllib.parse.quote(q)}&sort=stars&order=desc&per_page=30"

    headers = {
        "Accept": "application/vnd.github+json",
        "User-Agent": USER_AGENT,
    }
    if token:
        # GitHub accepts both "Bearer" and "token" prefix - "token" works with older PATs that "Bearer" rejects
        headers["Authorization"] = f"token {token}"

    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            data = json.loads(r.read().decode("utf-8"))
    except Exception as e:
        print(f"[scout] github search failed: {e}", file=sys.stderr)
        return []

    items = data.get("items", [])
    print(f"[scout] github returned {len(items)} repos (total available: {data.get('total_count', '?')})")
    # Client-side filter: only keep repos where language is exactly "Pine Script" or topic-confirmed
    pine_repos = []
    for r in items:
        lang = r.get("language") or ""
        topics = r.get("topics") or []
        if lang == "Pine Script" or "pinescript" in topics or "pine-script" in topics or "tradingview" in topics:
            pine_repos.append(r)
    print(f"[scout] after client-side filter: {len(pine_repos)} actually Pine repos")
    return pine_repos


def is_noise(repo):
    name_l = (repo.get("name", "") or "").lower()
    desc_l = (repo.get("description", "") or "").lower()
    for term in NOISE_TERMS:
        if term in name_l or term in desc_l:
            return True
    return False


def post_discord(msg):
    if not WEBHOOK_FILE.exists():
        print("[scout] no webhook, skip post")
        return False
    url = WEBHOOK_FILE.read_text().strip()
    if not url.startswith("http"):
        return False
    try:
        req = urllib.request.Request(
            url,
            data=json.dumps({"content": msg[:1900]}).encode("utf-8"),
            headers={"Content-Type": "application/json", "User-Agent": USER_AGENT},
        )
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.status in (200, 204)
    except Exception as e:
        print(f"[scout] discord post failed: {e}", file=sys.stderr)
        return False


def format_alert(repos):
    lines = ["**GitHub Pine Strategy Scout - weekly digest**"]
    lines.append(f"Found {len(repos)} new candidates passing filters (stars >= {MIN_STARS}, pushed within {PUSHED_WITHIN_DAYS} days)")
    lines.append("")
    for i, r in enumerate(repos, 1):
        stars = r.get("stargazers_count", 0)
        name = r.get("full_name", "?")
        pushed = (r.get("pushed_at", "") or "")[:10]
        desc = (r.get("description", "") or "")[:120]
        url = r.get("html_url", "")
        lines.append(f"{i}. **{name}** ({stars}*)")
        lines.append(f"   Pushed: {pushed}")
        lines.append(f"   Desc: {desc}")
        lines.append(f"   URL: {url}")
        lines.append("")
    lines.append("Review and queue worthy strategies into Pine build pipeline.")
    return "\n".join(lines)


def main():
    import argparse
    ap = argparse.ArgumentParser()
    ap.add_argument("--no-post", action="store_true", help="Skip Discord post (test mode)")
    ap.add_argument("--reset-seen", action="store_true", help="Reset seen-repos state to re-discover everything")
    args = ap.parse_args()

    if args.reset_seen:
        if STATE_FILE.exists():
            STATE_FILE.unlink()
        print("[scout] reset seen_repos state")

    seen = load_seen()
    repos = search_pine_repos()
    if not repos:
        print("[scout] no repos returned, exit")
        return

    new_repos = []
    for r in repos:
        full_name = r.get("full_name", "")
        if not full_name or full_name in seen:
            continue
        if is_noise(r):
            print(f"[scout] noise filter dropped: {full_name}")
            continue
        new_repos.append(r)

    print(f"[scout] {len(new_repos)} new candidates after filters")

    # Take top N by stars (already sorted by API)
    top = new_repos[:TOP_N_TO_POST]
    if not top:
        print("[scout] no new candidates this run")
        # Still update state with all seen repos (so we don't re-evaluate them)
        for r in repos:
            seen.add(r.get("full_name", ""))
        save_seen(seen)
        return

    msg = format_alert(top)
    print(msg)
    print("-" * 60)

    posted = False
    if not args.no_post:
        posted = post_discord(msg)
        print(f"[scout] discord posted: {posted}")

    # Persist all 30 we evaluated so we don't re-show them next week
    for r in repos:
        seen.add(r.get("full_name", ""))
    save_seen(seen)

    append_log({
        "ts": datetime.now(timezone.utc).isoformat(),
        "evaluated": len(repos),
        "new_candidates": len(new_repos),
        "posted_count": len(top),
        "posted_to_discord": posted,
        "top_names": [r.get("full_name") for r in top],
    })

    print(f"[scout] state saved, total seen={len(seen)}")


if __name__ == "__main__":
    main()
