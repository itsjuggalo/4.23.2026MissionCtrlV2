#!/usr/bin/env python3
"""
Blast-radius audit - maps every PM2 process and cron job to their outputs and consumers.
Flags single-points-of-failure: outputs that are read by 2+ downstream consumers.
"""
import json
import os
import re
import subprocess
from collections import defaultdict
from datetime import datetime, timezone, timedelta
from pathlib import Path

OUTPUT_REPORT = Path("/home/ubuntu/.openclaw/data/blast_radius_report.md")
OUTPUT_GRAPH = Path("/home/ubuntu/.openclaw/data/blast_radius_graph.json")
SCRIPTS_ROOT = Path("/home/ubuntu/scripts")
WORKSPACE_ROOT = Path("/home/ubuntu/.openclaw/workspace")
DATA_ROOT = Path("/home/ubuntu/.openclaw/data")

# === 1. Inventory PM2 processes ===
def get_pm2_processes():
    try:
        out = subprocess.check_output(["pm2", "jlist"], text=True, timeout=10)
        return json.loads(out)
    except Exception as e:
        print(f"[audit] pm2 jlist failed: {e}")
        return []

# === 2. Inventory crontab ===
def get_crontab_entries():
    try:
        out = subprocess.check_output(["crontab", "-l"], text=True, timeout=10)
    except Exception:
        return []
    entries = []
    for line in out.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or line.startswith("TZ="):
            continue
        # Extract script path - first thing matching /home/ubuntu/...py or .sh
        m = re.search(r"(/home/ubuntu/[^\s>]+\.(?:py|sh))", line)
        if m:
            entries.append({"line": line, "script": m.group(1)})
    return entries

# === 3. Find all output files written by scripts ===
WRITE_PATTERNS = [
    re.compile(r"\.write_text\("),
    re.compile(r"\.write_bytes\("),
    re.compile(r"open\([^)]*['\"]w['\"]"),
    re.compile(r"open\([^)]*['\"]wb['\"]"),
    re.compile(r"json\.dump\("),
    re.compile(r"with\s+open\([^)]*,\s*['\"]w['\"]"),
]

PATH_PATTERNS = [
    re.compile(r"['\"](/home/ubuntu/\.openclaw/[^'\"]+)['\"]"),
    re.compile(r"['\"](/home/ubuntu/mission-control/[^'\"]+)['\"]"),
    re.compile(r"['\"](/home/ubuntu/mission-control-restored/[^'\"]+)['\"]"),
    re.compile(r"WORKSPACE_DIR.*['\"]([^'\"]+\.json)['\"]"),
    re.compile(r"DIRECTIVES.*['\"]([^'\"]+\.json)['\"]"),
]

def scan_script_for_io(script_path):
    """Returns (writes, reads) lists of file paths the script touches."""
    if not script_path or not os.path.exists(script_path):
        return [], []
    try:
        text = Path(script_path).read_text(errors="ignore")
    except Exception:
        return [], []
    writes = set()
    reads = set()
    for pat in PATH_PATTERNS:
        for m in pat.finditer(text):
            path = m.group(1)
            # Find context - is this a write or read?
            start = max(0, m.start() - 100)
            end = min(len(text), m.end() + 100)
            context = text[start:end].lower()
            if any(p.search(context) for p in WRITE_PATTERNS) or "write" in context:
                writes.add(path)
            elif "read" in context or "load" in context or "json.load" in context:
                reads.add(path)
            else:
                reads.add(path)
    return list(writes), list(reads)

# === 4. Find consumers of each output file ===
def find_consumers_of_path(path, all_scripts):
    """Returns list of script paths that read this output."""
    consumers = []
    fname = os.path.basename(path)
    # Look for either full path or just filename
    for s in all_scripts:
        if not os.path.exists(s) or s.endswith((".bak", ".pyc")):
            continue
        try:
            text = Path(s).read_text(errors="ignore")
            if path in text or (fname and fname in text):
                consumers.append(s)
        except Exception:
            continue
    return consumers

# === 5. Health metrics ===
def file_age_minutes(path):
    if not os.path.exists(path):
        return None
    return (datetime.now().timestamp() - os.path.getmtime(path)) / 60

def main():
    print("[audit] Starting blast-radius scan")
    pm2 = get_pm2_processes()
    crons = get_crontab_entries()
    print(f"[audit] {len(pm2)} PM2 procs, {len(crons)} cron entries")

    # Collect all live scripts
    all_scripts = set()
    for p in pm2:
        s = p.get("pm2_env", {}).get("pm_exec_path", "")
        if s:
            all_scripts.add(s)
    for c in crons:
        all_scripts.add(c["script"])
    # Also include all .py files in /home/ubuntu/scripts (excluding .bak)
    for f in SCRIPTS_ROOT.rglob("*.py"):
        if ".bak" not in str(f) and "__pycache__" not in str(f):
            all_scripts.add(str(f))
    all_scripts = sorted(all_scripts)
    print(f"[audit] {len(all_scripts)} unique live scripts to analyze")

    # Map producers
    producers = {}  # path -> [scripts that write it]
    consumers = defaultdict(list)  # path -> [scripts that read it]

    for s in all_scripts:
        writes, reads = scan_script_for_io(s)
        for w in writes:
            producers.setdefault(w, []).append(s)
        for r in reads:
            consumers[r].append(s)

    # SPOF detection: outputs read by 2+ consumers AND written by exactly 1 producer
    spofs = []
    for path, prods in producers.items():
        cons = consumers.get(path, [])
        if len(cons) >= 2 and len(prods) == 1:
            age = file_age_minutes(path)
            spofs.append({
                "path": path,
                "producer": prods[0],
                "consumer_count": len(cons),
                "consumers": cons[:5],
                "age_minutes": round(age, 1) if age is not None else None,
            })
    spofs.sort(key=lambda x: -x["consumer_count"])

    # Stale critical files
    stale = []
    critical_paths = [
        "/home/ubuntu/.openclaw/workspace/directives/firebase_trade_signals.json",
        "/home/ubuntu/.openclaw/workspace/directives/grok_brief.json",
        "/home/ubuntu/.openclaw/workspace/directives/market_briefing.json",
        "/home/ubuntu/.openclaw/workspace/directives/kronos_forecast.json",
        "/home/ubuntu/.openclaw/workspace/skill_outputs/boba_decisions_validated.json",
    ]
    for cp in critical_paths:
        age = file_age_minutes(cp)
        if age is None:
            stale.append({"path": cp, "status": "MISSING"})
        elif age > 240:  # 4 hours
            stale.append({"path": cp, "age_minutes": round(age, 1), "status": "STALE"})

    # Restart hotspots
    restart_hotspots = []
    for p in pm2:
        n = p.get("pm2_env", {}).get("restart_time", 0)
        if n >= 5:
            restart_hotspots.append({
                "name": p.get("name"),
                "restarts": n,
                "script": p.get("pm2_env", {}).get("pm_exec_path", "?"),
            })
    restart_hotspots.sort(key=lambda x: -x["restarts"])

    # Cron duplicate detection
    script_count = defaultdict(int)
    for c in crons:
        script_count[c["script"]] += 1
    cron_duplicates = [(s, n) for s, n in script_count.items() if n >= 5]
    cron_duplicates.sort(key=lambda x: -x[1])

    # Write graph JSON
    graph = {
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "pm2_count": len(pm2),
        "cron_count": len(crons),
        "live_scripts": len(all_scripts),
        "producers": producers,
        "consumers": dict(consumers),
        "spofs": spofs,
        "stale_critical": stale,
        "restart_hotspots": restart_hotspots,
        "cron_duplicates": cron_duplicates,
    }
    OUTPUT_GRAPH.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT_GRAPH.write_text(json.dumps(graph, indent=2, default=str))

    # Write markdown report (ET timestamps)
    et_now = datetime.now() - timedelta(hours=4)
    lines = []
    lines.append(f"# Blast-Radius Audit Report")
    lines.append(f"**Generated:** {et_now.strftime('%Y-%m-%d %H:%M ET')}")
    lines.append("")
    lines.append("## Top-Level Stats")
    lines.append(f"- PM2 processes: {len(pm2)}")
    lines.append(f"- Cron entries: {len(crons)}")
    lines.append(f"- Live scripts analyzed: {len(all_scripts)}")
    lines.append(f"- Single-points-of-failure detected: {len(spofs)}")
    lines.append(f"- Stale critical files: {len(stale)}")
    lines.append(f"- Restart hotspots (>=5 restarts): {len(restart_hotspots)}")
    lines.append("")

    lines.append("## SINGLE POINTS OF FAILURE (Top 15)")
    lines.append("Outputs with multiple downstream consumers but only ONE producer.")
    lines.append("If the producer breaks, ALL consumers degrade silently.")
    lines.append("")
    for i, s in enumerate(spofs[:15], 1):
        lines.append(f"### {i}. {os.path.basename(s['path'])}")
        lines.append(f"- Path: `{s['path']}`")
        lines.append(f"- Producer: `{os.path.basename(s['producer'])}`")
        lines.append(f"- Consumer count: {s['consumer_count']}")
        if s["age_minutes"] is not None:
            lines.append(f"- Output age: {s['age_minutes']} min")
        lines.append(f"- Sample consumers: {', '.join(os.path.basename(c) for c in s['consumers'])}")
        lines.append("")

    lines.append("## STALE CRITICAL FILES")
    if stale:
        for s in stale:
            if s["status"] == "MISSING":
                lines.append(f"- {s['path']}: MISSING")
            else:
                lines.append(f"- {s['path']}: {s['age_minutes']} min old (STALE)")
    else:
        lines.append("All critical files fresh.")
    lines.append("")

    lines.append("## PM2 RESTART HOTSPOTS")
    if restart_hotspots:
        for r in restart_hotspots:
            lines.append(f"- {r['name']}: {r['restarts']} restarts ({r['script']})")
    else:
        lines.append("No hotspots (all under 5 restarts).")
    lines.append("")

    lines.append("## CRON DUPLICATES")
    lines.append("Scripts scheduled 5+ times in the same crontab.")
    if cron_duplicates:
        for s, n in cron_duplicates:
            lines.append(f"- {os.path.basename(s)}: {n} entries ({s})")
    else:
        lines.append("No duplicates.")
    lines.append("")

    OUTPUT_REPORT.write_text("\n".join(lines))
    print(f"[audit] Report written to {OUTPUT_REPORT}")
    print(f"[audit] Graph written to {OUTPUT_GRAPH}")

    # Print summary to stdout
    print()
    print("=" * 60)
    print(f"BLAST-RADIUS SUMMARY")
    print("=" * 60)
    print(f"SPOFs detected: {len(spofs)}")
    print(f"Stale critical files: {len(stale)}")
    print(f"Restart hotspots: {len(restart_hotspots)}")
    print(f"Cron duplicates: {len(cron_duplicates)}")
    if spofs:
        print()
        print("TOP 5 SPOFs:")
        for i, s in enumerate(spofs[:5], 1):
            print(f"  {i}. {os.path.basename(s['path'])} - {s['consumer_count']} consumers")

if __name__ == "__main__":
    main()
