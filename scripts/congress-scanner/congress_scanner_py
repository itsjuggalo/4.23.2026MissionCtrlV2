#!/usr/bin/env python3
"""
Congress trade scanner - Item 35.

Layer 1: poll House Clerk official disclosure ZIP for current year, extract
all PTR filings (FilingType=P), alert on watchlist Members and on bulk filing
days (3+ Members same week = potential coordinated rotation signal).

Source: https://disclosures-clerk.house.gov/public_disc/financial-pdfs/{YEAR}FD.zip
Updated daily by House Clerk office. Free, no-auth, official source.

State: openclaw/state/congress_scanner/seen_filings.json (DocID set).
Log:   openclaw/state/congress_scanner/filings_log.jsonl (full filing record).
Discord: discord_sec_scanners_webhook (same channel as Form 4 + 13F).

Tier scoring:
  T1 - high-signal Member files PTR (Pelosi, Crenshaw, Tuberville etc.)
  T2 - 3+ Members file PTR same calendar day (cluster signal)
  T3 - any other PTR (log only, no Discord)

Layer 2 (deferred): fetch + parse PTR PDFs for ticker-level data.
Once tested, add pdfplumber-based extraction for actual trade rows.
"""
import json
import os
import sys
import time
import urllib.request
import urllib.error
import zipfile
import io
from collections import defaultdict, Counter
from datetime import datetime, timezone, timedelta
from pathlib import Path
from xml.etree import ElementTree as ET

WEBHOOK_FILE = Path("/home/ubuntu/.openclaw/secrets/discord_sec_scanners_webhook")
STATE_DIR = Path("/home/ubuntu/.openclaw/state/congress_scanner")
STATE_FILE = STATE_DIR / "seen_filings.json"
LOG_FILE = STATE_DIR / "filings_log.jsonl"

USER_AGENT = "MissionCtrl Trading Research mike@missionctrl.serveftp.com"

# High-signal Members - notorious or historically high-performing traders
# Names match Last field in House XML (case-insensitive substring match)
HIGH_SIGNAL_MEMBERS = {
    "Pelosi",       # Nancy Pelosi - famously well-timed trades
    "Crenshaw",     # Dan Crenshaw - active options trader
    "Greene",       # Marjorie Taylor Greene - active trader
    "Tuberville",   # Tommy Tuberville - active trader (Senate, but tracked here too)
    "Garamendi",    # John Garamendi - frequent filer
    "Khanna",       # Ro Khanna - frequent filer
    "Gottheimer",   # Josh Gottheimer
    "Higgins",      # Brian Higgins
    "Mfume",        # Kweisi Mfume
    "Spanberger",   # Abigail Spanberger
    "Hoyer",        # Steny Hoyer
}

CLUSTER_MIN_MEMBERS = 3  # 3+ Members filing PTRs same day = signal
CLUSTER_WINDOW_DAYS = 1  # within 24h


def http_get_bytes(url, timeout=30):
    req = urllib.request.Request(url, headers={
        "User-Agent": USER_AGENT,
        "Accept": "application/zip,application/octet-stream,*/*",
        "Accept-Encoding": "identity",
    })
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read()


def fetch_house_disclosures(year):
    """Returns list of dicts parsed from {YEAR}FD.xml inside the official ZIP."""
    url = f"https://disclosures-clerk.house.gov/public_disc/financial-pdfs/{year}FD.zip"
    try:
        zbytes = http_get_bytes(url)
    except Exception as e:
        print(f"[congress] fetch failed for {year}: {e}", file=sys.stderr)
        return []

    try:
        with zipfile.ZipFile(io.BytesIO(zbytes)) as z:
            xml_name = f"{year}FD.xml"
            if xml_name not in z.namelist():
                print(f"[congress] {xml_name} not in zip", file=sys.stderr)
                return []
            xml_text = z.read(xml_name).decode("utf-8", errors="replace")
    except Exception as e:
        print(f"[congress] zip parse failed: {e}", file=sys.stderr)
        return []

    try:
        root = ET.fromstring(xml_text)
    except Exception as e:
        print(f"[congress] xml parse failed: {e}", file=sys.stderr)
        return []

    out = []
    for m in root.findall("Member"):
        rec = {child.tag: (child.text or "").strip() for child in m}
        out.append(rec)
    return out


def load_state():
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text())
        except Exception:
            pass
    return {"seen_doc_ids": []}


def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2))


def append_log(rec):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a") as f:
        f.write(json.dumps(rec) + "\n")


def parse_filing_date(s):
    """House feed uses M/D/YYYY format."""
    if not s:
        return None
    try:
        return datetime.strptime(s.strip(), "%m/%d/%Y").replace(tzinfo=timezone.utc)
    except Exception:
        return None


def is_high_signal(last_name):
    if not last_name:
        return False
    ln = last_name.strip().lower()
    return any(name.lower() in ln or ln in name.lower() for name in HIGH_SIGNAL_MEMBERS)


def post_discord(msg):
    if not WEBHOOK_FILE.exists():
        print("[congress] no webhook file, skip post")
        return False
    url = WEBHOOK_FILE.read_text().strip()
    if not url.startswith("http"):
        print("[congress] webhook empty, skip post")
        return False
    try:
        req = urllib.request.Request(
            url,
            data=json.dumps({"content": msg[:1900]}).encode("utf-8"),
            headers={"Content-Type": "application/json", "User-Agent": USER_AGENT},
        )
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.status in (200, 204)
    except Exception as e:
        print(f"[congress] discord post failed: {e}")
        return False


def format_t1_alert(rec):
    return (
        f"**T1 Congress Filing - high-signal Member**\n"
        f"Member: {rec.get('Prefix','')} {rec.get('First','')} {rec.get('Last','')} ({rec.get('StateDst','?')})\n"
        f"FilingType: {rec.get('FilingType','?')} (P=PTR, W=Withdrawn, A=Amendment, O=New, X=Extension)\n"
        f"FilingDate: {rec.get('FilingDate','?')}\n"
        f"DocID: {rec.get('DocID','?')}\n"
        f"PTR PDF: https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/{rec.get('Year','2026')}/{rec.get('DocID','?')}.pdf"
    )


def format_t2_cluster(date_str, members):
    names = ", ".join(f"{m.get('First','')[:1]}. {m.get('Last','?')}" for m in members[:10])
    extra = f" + {len(members)-10} more" if len(members) > 10 else ""
    return (
        f"**T2 Congress cluster - {len(members)} PTRs filed {date_str}**\n"
        f"Members: {names}{extra}\n"
        f"Cluster signal - check for coordinated sector rotation"
    )


def main():
    import argparse
    ap = argparse.ArgumentParser()
    ap.add_argument("--no-post", action="store_true", help="skip Discord posts (for seed run)")
    args = ap.parse_args()
    year = datetime.now(timezone.utc).year
    print(f"[congress] polling House Clerk year={year}")

    records = fetch_house_disclosures(year)
    print(f"[congress] fetched {len(records)} filings")
    if not records:
        print("[congress] no records, exit")
        return

    state = load_state()
    seen = set(state.get("seen_doc_ids", []))
    new_records = []
    ptr_records = []  # PTRs only (FilingType=P)

    for r in records:
        doc_id = r.get("DocID", "").strip()
        ftype = r.get("FilingType", "").strip().upper()
        if not doc_id or doc_id in seen:
            continue
        new_records.append(r)
        if ftype == "P":  # Periodic Transaction Report = actual stock trades
            ptr_records.append(r)
        append_log({**r, "ingested_at": datetime.now(timezone.utc).isoformat()})

    print(f"[congress] {len(new_records)} new filings ({len(ptr_records)} PTRs)")

    # T1: high-signal Member PTRs
    t1_alerts = []
    for r in ptr_records:
        if is_high_signal(r.get("Last", "")):
            t1_alerts.append(r)

    # T2: cluster - 3+ Members file PTRs same calendar day
    by_date = defaultdict(list)
    for r in ptr_records:
        d = r.get("FilingDate", "")
        if d:
            by_date[d].append(r)
    t2_clusters = [(d, members) for d, members in by_date.items() if len(members) >= CLUSTER_MIN_MEMBERS]

    # Post alerts
    posted = 0
    for r in t1_alerts:
        msg = format_t1_alert(r)
        print(msg)
        print("-" * 60)
        if not args.no_post and post_discord(msg):
            posted += 1
    for date_str, members in t2_clusters:
        msg = format_t2_cluster(date_str, members)
        print(msg)
        print("-" * 60)
        if not args.no_post and post_discord(msg):
            posted += 1

    print(f"[congress] posted {posted} alerts ({len(t1_alerts)} T1 + {len(t2_clusters)} T2)")

    # Update state
    for r in new_records:
        seen.add(r.get("DocID", ""))
    state["seen_doc_ids"] = list(seen)
    state["last_run"] = datetime.now(timezone.utc).isoformat()
    state["last_year_polled"] = year
    state["totals"] = {
        "filings_seen": len(seen),
        "ptrs_seen": sum(1 for line in LOG_FILE.read_text().splitlines() if line and '"FilingType": "P"' in line) if LOG_FILE.exists() else 0,
    }
    save_state(state)
    print(f"[congress] state saved, total seen={len(seen)}")


if __name__ == "__main__":
    main()
