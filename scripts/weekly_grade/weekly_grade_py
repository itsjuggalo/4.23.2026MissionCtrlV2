"""Weekly self-grading loop. Reads past 7 days of Boba decisions + R1/R2 P&L,
benchmarks against SPY/QQQ/BTC, calls Sonnet to grade A-F + propose edits."""
import os, json, sys, urllib.request, urllib.parse
from datetime import datetime, timedelta, timezone
from pathlib import Path
import sys as _sys_tracker
_sys_tracker.path.insert(0, '/home/ubuntu/scripts/lib')
from anthropic_tracker import log_call as _log_anthropic_call
import time as _time_tracker

SECRETS = Path('/home/ubuntu/.openclaw/secrets')
PROPOSALS = Path('/home/ubuntu/.openclaw/workspace/proposals')
BOBA_LOG = Path('/home/ubuntu/.openclaw/workspace/skill_outputs/boba_decisions_validated.json')
JAZZY_LOG = Path('/home/ubuntu/.openclaw/workspace/skill_outputs/jazzy_decisions_validated.json')

def load_secret(name):
    p = SECRETS / name
    return p.read_text().strip() if p.exists() else None

ANTHROPIC_KEY = load_secret('anthropic_api_key')
ALPACA_KEY_R2 = load_secret('alpaca-key-id')
ALPACA_SEC_R2 = load_secret('alpaca-secret')
ALPACA_KEY_R1 = load_secret('alpaca-r1-key-id')
ALPACA_SEC_R1 = load_secret('alpaca-r1-secret')
ALPACA_KEY_JAZZY = load_secret('alpaca-jazzy-key-id')
ALPACA_SEC_JAZZY = load_secret('alpaca-jazzy-secret')
WEBHOOK = load_secret('discord_performance_weekly_webhook')

def alpaca_get(path, key, sec):
    req = urllib.request.Request(
        f'https://paper-api.alpaca.markets{path}',
        headers={'APCA-API-KEY-ID': key, 'APCA-API-SECRET-KEY': sec})
    return json.loads(urllib.request.urlopen(req, timeout=30).read())

def get_account_pnl(key, sec, label):
    """Get 7-day equity change for an Alpaca account."""
    try:
        end = datetime.now(timezone.utc)
        start = end - timedelta(days=7)
        path = f'/v2/account/portfolio/history?period=1W&timeframe=1D'
        data = alpaca_get(path, key, sec)
        eq = data.get('equity', [])
        if len(eq) >= 2 and eq[0]:
            pct = ((eq[-1] - eq[0]) / eq[0]) * 100
            return {'label': label, 'start': eq[0], 'end': eq[-1], 'pct': round(pct, 2)}
    except Exception as e:
        return {'label': label, 'error': str(e)}
    return {'label': label, 'error': 'no data'}

def get_yahoo_pct(symbol):
    """7-day percent change from Yahoo Finance (free, no auth)."""
    try:
        url = f'https://query1.finance.yahoo.com/v8/finance/chart/{symbol}?range=7d&interval=1d'
        req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
        d = json.loads(urllib.request.urlopen(req, timeout=15).read())
        closes = d['chart']['result'][0]['indicators']['quote'][0]['close']
        closes = [c for c in closes if c is not None]
        if len(closes) >= 2:
            pct = ((closes[-1] - closes[0]) / closes[0]) * 100
            return round(pct, 2)
    except Exception as e:
        return None
    return None

def load_jazzy_decisions():
    """Last 7 days of JazzyHazzy decisions."""
    if not JAZZY_LOG.exists():
        return []
    try:
        data = _json.loads(JAZZY_LOG.read_text())
        cutoff = datetime.now(timezone.utc) - timedelta(days=7)
        out = []
        for d in data:
            try:
                ts = datetime.fromisoformat(d.get('cycle_time', '').replace('Z', '+00:00'))
                if ts >= cutoff:
                    out.append(d)
            except Exception:
                pass
        return out
    except Exception:
        return []


def load_boba_decisions():
    """Last 7 days of Boba decisions."""
    if not BOBA_LOG.exists():
        return []
    try:
        data = json.loads(BOBA_LOG.read_text())
    except Exception:
        return []
    cutoff = datetime.now(timezone.utc) - timedelta(days=7)
    out = []
    for d in data if isinstance(data, list) else []:
        ts = d.get('timestamp') or d.get('cycle_time') or d.get('time')
        try:
            if ts and datetime.fromisoformat(ts.replace('Z', '+00:00')) > cutoff:
                out.append(d)
        except Exception:
            pass
    return out

def call_claude(prompt):
    body = json.dumps({
        'model': 'claude-sonnet-4-5',
        'max_tokens': 4000,
        'messages': [{'role': 'user', 'content': prompt}],
    }).encode()
    req = urllib.request.Request(
        'https://api.anthropic.com/v1/messages',
        data=body,
        headers={
            'x-api-key': ANTHROPIC_KEY,
            'anthropic-version': '2023-06-01',
            'content-type': 'application/json',
        })
    resp = json.loads(urllib.request.urlopen(req, timeout=90).read())
    return resp['content'][0]['text']

def post_discord(content):
    if not WEBHOOK: return
    body = json.dumps({'content': content[:1990]}).encode()
    req = urllib.request.Request(WEBHOOK, data=body, headers={'content-type': 'application/json'})
    try: urllib.request.urlopen(req, timeout=15)
    except Exception as e: print(f'webhook err: {e}', file=sys.stderr)

def main():
    print('[1/4] Pulling P&L...')
    r1 = get_account_pnl(ALPACA_KEY_R1, ALPACA_SEC_R1, 'R1')
    r2 = get_account_pnl(ALPACA_KEY_R2, ALPACA_SEC_R2, 'R2')
    jazzy = get_account_pnl(ALPACA_KEY_JAZZY, ALPACA_SEC_JAZZY, 'JazzyHazzy')
    spy = get_yahoo_pct('SPY')
    qqq = get_yahoo_pct('QQQ')
    btc = get_yahoo_pct('BTC-USD')
    print(f'  R1: {r1}\n  R2: {r2}\n  JazzyHazzy: {jazzy}\n  SPY: {spy}%  QQQ: {qqq}%  BTC: {btc}%')

    print('[2/4] Loading Boba + JazzyHazzy decisions...')
    decisions = load_boba_decisions()
    jazzy_decisions = load_jazzy_decisions()
    print(f'  Boba: {len(decisions)} decisions | JazzyHazzy: {len(jazzy_decisions)} decisions in past 7 days')

    print('[3/4] Calling Claude for grade + edits...')
    summary = {
        'period': '7 days',
        'r1': r1, 'r2': r2,
        'benchmarks': {'SPY': spy, 'QQQ': qqq, 'BTC': btc},
        'r2_minus_r1': (r2.get('pct', 0) - r1.get('pct', 0)) if 'pct' in r2 and 'pct' in r1 else None,
        'r2_minus_spy': (r2.get('pct', 0) - spy) if 'pct' in r2 and spy is not None else None,
        'jazzy': jazzy,
        'jazzy_minus_r2': (jazzy.get('pct', 0) - r2.get('pct', 0)) if 'pct' in jazzy and 'pct' in r2 else None,
        'jazzy_minus_spy': (jazzy.get('pct', 0) - spy) if 'pct' in jazzy and spy is not None else None,
        'jazzy_decision_count': len(jazzy_decisions),
        'decision_count': len(decisions),
        'sample_decisions': decisions[:10],
    }
    prompt = f"""You are grading TWO trading agents head-to-head over the past 7 days. Both are multi-agent algorithmic options trading systems sharing the same whale flow signals and Kronos forecasts but using different models and risk profiles.\n\nAGENTS UNDER REVIEW:\n- Boba: Anthropic Claude Sonnet, R2 paper account ($503K, L3 margin), AGGRESSIVE — takes short-DTE plays.\n- JazzyHazzy: OpenAI GPT-4o-mini, R1 paper account ($10K, L3 4x margin), CONSERVATIVE — HARD GATE rejecting <14 DTE without 3-condition override (flow ≥90, Kronos 2x breakeven, named catalyst).\n\nR1 (PA3Y7UTNIQFZ) is a separate hold-only Boba account ($150K, L2) used as a passive baseline.

PERFORMANCE DATA:
{json.dumps(summary, indent=2, default=str)}

Grade Boba's week on an A-F academic scale. Consider:
- Boba R2 P&L absolute and vs SPY/QQQ benchmarks
- JazzyHazzy P&L absolute and vs SPY/QQQ benchmarks
- HEAD-TO-HEAD: JazzyHazzy vs Boba — did the conservative DTE gate pay off this week or cost upside?
- Either agent vs R1 hold-only baseline (passive benchmark)
- For each agent separately: name what worked and what failed, then propose targeted skill edits per agent
- Decision quality from sample_decisions (entry criteria cited, brief context used, protocol consistency)

Output strict JSON with this schema:
{{
  "grade": "A|A-|B+|B|B-|C+|C|C-|D|F",
  "headline": "one sentence summary",
  "what_worked": ["...", "..."],
  "what_failed": ["...", "..."],
  "proposed_edits": [
    {{"target": "SOUL.md|IDENTITY.md|skills/X|prompt_section_Y", "current": "what it says now (paraphrase ok)", "proposed": "what to change it to", "rationale": "why"}}
  ]
}}

Output ONLY the JSON, no markdown fences, no preamble."""
    raw = call_claude(prompt)
    raw = raw.strip().lstrip('`').lstrip('json').strip()
    if raw.endswith('`'): raw = raw.rstrip('`').strip()
    try:
        graded = json.loads(raw)
    except Exception as e:
        graded = {'grade': '?', 'headline': f'parse error: {e}', 'raw': raw[:500]}

    print('[4/4] Writing proposal + posting digest...')
    PROPOSALS.mkdir(parents=True, exist_ok=True)
    today = datetime.now(timezone.utc).strftime('%Y-%m-%d')
    out_path = PROPOSALS / f'{today}-weekly-grade'
    out_path.write_text(json.dumps({'summary': summary, 'graded': graded}, indent=2, default=str))
    print(f'  wrote {out_path}')

    # Discord digest
    edits = graded.get('proposed_edits', [])
    digest = f"""**Weekly Grade — {today}** | **{graded.get('grade', '?')}**
{graded.get('headline', '')}

R1 hold: {r1.get('pct','?')}%  |  Boba R2: {r2.get('pct','?')}%  |  JazzyHazzy: {jazzy.get('pct','?')}%  |  SPY: {spy}%  QQQ: {qqq}%  BTC: {btc}%
Decisions: {len(decisions)}

**Worked:** {' | '.join(graded.get('what_worked', [])[:3])}
**Failed:** {' | '.join(graded.get('what_failed', [])[:3])}
**Proposed edits:** {len(edits)} (review at {out_path})"""
    post_discord(digest)
    print('  digest posted')
    print('DONE')

if __name__ == '__main__':
    main()
