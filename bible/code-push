#!/bin/bash
# Auto-push code to itsjuggalo/4.23.2026MissionCtrlV2
# Stashes local changes before pull, restores after, fixes word-split bug in exclude list.
set -e
REPO_DIR="/home/ubuntu/backup-4.23.2026MCV2"
SOURCE_ROOT="/home/ubuntu/scripts"
WIP_LIST="/home/ubuntu/.openclaw/state/code_wip/wip.list"
COMMIT_TITLE="${1:-auto-push}"
COMMIT_DETAIL="${2:-}"

cd "$REPO_DIR"

# Stash any local changes (modified or staged) before pull
STASH_CREATED=0
if ! git diff-index --quiet HEAD -- 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
  if git stash push -u -m "code-push auto-stash $(date +%s)" >/dev/null 2>&1; then
    STASH_CREATED=1
  fi
fi

# Pull rebase from origin main
if ! git pull --rebase origin main >/dev/null 2>&1; then
  echo "[code-push] Pull failed - attempting recovery"
  git rebase --abort 2>/dev/null || true
  if [ "$STASH_CREATED" = "1" ]; then
    git stash pop >/dev/null 2>&1 || true
  fi
  exit 1
fi

# Restore any stashed changes
if [ "$STASH_CREATED" = "1" ]; then
  git stash pop >/dev/null 2>&1 || echo "[code-push] Warning - stash pop had conflicts"
fi

mkdir -p scripts

# Build exclude args as bash array (fixes word-splitting on paths with spaces or special chars)
EXCLUDE_ARGS=()
if [ -f "$WIP_LIST" ]; then
  while IFS= read -r wip_path; do
    [ -z "$wip_path" ] && continue
    rel_path="${wip_path#$SOURCE_ROOT/}"
    EXCLUDE_ARGS+=("--exclude=$rel_path")
  done < "$WIP_LIST"
fi


# Hardcoded sensitive file exclusions (added after Discord token leak May 2026)
SAFE_EXCLUDES=(
  --exclude="*_token*"
  --exclude="*token.txt"
  --exclude="*token.key"
  --exclude="*_key*"
  --exclude="*key.txt"
  --exclude="*_secret*"
  --exclude="*secret.txt"
  --exclude="*_password*"
  --exclude="*password.txt"
  --exclude="*.env"
  --exclude=".env*"
  --exclude="*.pem"
  --exclude="*.b64"
  --exclude="*api_key*"
  --exclude="*_api*"
  --exclude="creds*"
  --exclude="credentials*"
)
# Rsync source to repo using array expansion (proper quoting)
rsync -a "${EXCLUDE_ARGS[@]}" "${SAFE_EXCLUDES[@]}" --exclude="__pycache__/" --exclude="*.pyc" --exclude="weekly_grade/replay/data" "$SOURCE_ROOT/" "$REPO_DIR/scripts/"

git add -A scripts/

if git diff --cached --quiet; then
  echo "[code-push] No code changes to push"
  exit 0
fi

COMMIT_MSG="$COMMIT_TITLE"
[ -n "$COMMIT_DETAIL" ] && COMMIT_MSG="$COMMIT_MSG

$COMMIT_DETAIL"

git commit -m "$COMMIT_MSG" >/dev/null
git push origin main 2>&1 | tail -3
echo "[code-push] OK"
