#!/bin/bash
F="$1"
[ -z "$F" ] && { echo "Usage: wip-mark <file>"; exit 1; }
ABS="$(realpath "$F" 2>/dev/null || echo "$F")"
WIP_LIST="/home/ubuntu/.openclaw/state/code_wip/wip.list"
touch "$WIP_LIST"
grep -qxF "$ABS" "$WIP_LIST" || echo "$ABS" >> "$WIP_LIST"
echo "WIP: $ABS"
echo "Total WIP: $(wc -l < "$WIP_LIST")"
