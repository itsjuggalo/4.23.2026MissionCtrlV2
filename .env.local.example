# MissionCtrlV2 — local environment example
# Copy to .env.local and fill in real values.
# chmod 600 .env.local (owner-readable only)

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY WARNING: Tunnel deployments
# ─────────────────────────────────────────────────────────────────────────────
# This dashboard is built for http://localhost:3000 on a trusted workstation.
# If you expose it via ngrok, cloudflare tunnel, or any other reverse proxy,
# you MUST:
#   1. Switch to MISSIONCTRL_EXEC_MODE=token-headless
#   2. Place a reverse proxy with its own auth layer in front
#   3. Set MISSIONCTRL_ORIGIN to your public URL
# The in-process auth is not designed for hostile networks.

# ─────────────────────────────────────────────────────────────────────────────
# Auth & Session
# ─────────────────────────────────────────────────────────────────────────────

# 32-byte hex session signing secret. Generate: openssl rand -hex 32
# REQUIRED if MISSIONCTRL_EXEC_MODE != disabled. App crashes if missing.
MISSIONCTRL_SESSION_SECRET=

# Bearer token for headless/curl access (MISSIONCTRL_EXEC_MODE=token-headless)
# Generate: openssl rand -hex 32
MISSIONCTRL_EXEC_TOKEN=

# Execution auth mode: browser-session | token-headless | disabled
# Default: browser-session
MISSIONCTRL_EXEC_MODE=browser-session

# Auth enforcement: warn (log but pass) | enforce (reject unauthenticated)
# Start with warn, then flip to enforce after verifying your session works.
# Default: warn
MISSIONCTRL_AUTH_MODE=warn

# Dashboard origin for Origin pinning (exact match, no trailing slash)
# Default: http://localhost:3000
MISSIONCTRL_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────────────────────

# Enable dashboard SQLite telemetry (itb_runs, freqtrade_runs, live_strategy_pulse)
# Default: true (set false to run in memoryless mode)
MISSIONCTRL_DB_ENABLED=true

# Allow POST /api/itb and /api/freqtrade to spawn processes
# Default: false (enable only after all canary checks pass — see PLAN.md Phase 5d)
MISSIONCTRL_EXEC_ENABLED=false

# Enable the live strategy pulse timer (mc-livestrategy-pulse.timer)
# Default: true
MISSIONCTRL_LS_TIMER_ENABLED=true

# Per-page v2 chart-heavy UI rollout (comma-separated page names)
# Pages not listed render their pre-PR component.
# Set to: desk,itb,freqtrade,live-strategy once stable.
# Default: empty (all pages use pre-PR UI)
MISSIONCTRL_UI_V2_PAGES=

# Enable nightly data retention job (mc-dashboard-retention.timer)
# Default: false (enable after first month when there's data worth pruning)
MISSIONCTRL_RETENTION_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Live Strategy OHLC + Pair Caps
# ─────────────────────────────────────────────────────────────────────────────

# Max number of pairs to return price_history for (hard cap)
# Default: 20
MISSIONCTRL_LS_MAX_PAIRS=20

# Trailing days of 1h bars to include per pair (max 200 bars enforced regardless)
# Default: 7
MISSIONCTRL_LS_HISTORY_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# Stale Run Thresholds (milliseconds)
# ─────────────────────────────────────────────────────────────────────────────

# Freqtrade backtesting: 2 hours
MISSIONCTRL_RUN_STALE_MS_BACKTESTING=7200000

# Freqtrade download-data: 1 hour
MISSIONCTRL_RUN_STALE_MS_DOWNLOAD_DATA=3600000

# ITB scripts: 30 minutes
MISSIONCTRL_RUN_STALE_MS_DEFAULT=1800000

# ─────────────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────────────

# Discord webhook URL for ops alerts (pulse gaps, stuck runs, health failures)
# Leave empty to disable webhooks.
MISSIONCTRL_OPS_WEBHOOK=

# ─────────────────────────────────────────────────────────────────────────────
# TradingView Webhook  (/api/tv-webhook/[secret])
# ─────────────────────────────────────────────────────────────────────────────

# URL-path secret that must match the [secret] segment of the webhook URL.
# Generate: openssl rand -hex 16
TV_WEBHOOK_SLUG=

# Comma-separated account names that can receive webhook traffic.
TV_WEBHOOK_ACCOUNTS=boba,jazzy

# Set true to enable the webhook handler at all.
TV_WEBHOOK_ENABLED=false

# Set TV_WEBHOOK_LIVE=true to route fills to Alpaca LIVE keys.
# Requires TV_WEBHOOK_LIVE_ACK=I_UNDERSTAND as an explicit safety gate.
TV_WEBHOOK_LIVE=false
TV_WEBHOOK_LIVE_ACK=

# ─────────────────────────────────────────────────────────────────────────────
# External API Keys
# ─────────────────────────────────────────────────────────────────────────────

# Finnhub — stocks, candles, stock detail drawer
# Get a free key at https://finnhub.io
FINNHUB_API_KEY=

# Anthropic — psych-chat route (/api/psych-chat)
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Wallet / Crypto
# ─────────────────────────────────────────────────────────────────────────────

# Password checked by /api/wallet-auth and /api/wallets before returning keys.
WALLET_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Bridge (Flow Database proxy to Oracle)
# ─────────────────────────────────────────────────────────────────────────────
BRIDGE_URL=https://bridge.serveftp.com
BRIDGE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Optional overrides
# ─────────────────────────────────────────────────────────────────────────────

# Absolute path to the claude binary (overrides auto-detection in /api/copilot).
# Leave empty to let the route search its default candidate list.
CLAUDE_CLI_PATH=
