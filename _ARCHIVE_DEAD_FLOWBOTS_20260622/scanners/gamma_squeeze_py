#!/usr/bin/env python3
"""
Scanner #11 - Gamma Squeeze Scanner
Reads flow_liveflows_today.json (24K+ flows). Aggregates volume by (symbol, strike, expiry).
Flags symbols where one strike has 5x+ normal call volume concentration near spot.
Runs every 15 min during market hours, posts top candidates to Discord.
"""
import json, time, logging, requests
from pathlib import Path
from datetime import datetime, timezone
from collections import defaultdict

logging.basicConfig(level=logging.INFO, format='%(asctime)s [gamma] %(message)s', datefmt='%H:%M:%S')

SCRAPER = Path('/home/ubuntu/mission-control-restored/Option-Signals-Scraper/data')
OUT = Path('/home/ubuntu/.openclaw/data/scanners/gamma_squeeze.json')
OUT.parent.mkdir(parents=True, exist_ok=True)
STATE = Path('/home/ubuntu/.openclaw/data/scanners/gamma_squeeze_state.json')

WEBHOOK = 'https://discordapp.com/api/webhooks/1497661681126609008/tlS_qnTSq4Uef8AUVpllp2vwC3sJ7u0BHt2_WcoJz5y75dnh3cgHpkhOn59zGlkWmyPk'

CONCENTRATION_MIN = 0.30  # one strike must be at least 30% of total symbol volume
MIN_TOTAL_VOLUME = 5000   # symbol must have decent total flow
MAX_DTE_DAYS = 30         # near-dated only

def cycle():
    p = SCRAPER / 'flow_liveflows_today.json'
    if not p.exists():
        logging.warning('flow_liveflows_today missing')
        return []
    try: data = json.loads(p.read_text())
    except: return []

    items = data.values() if isinstance(data, dict) else (data if isinstance(data, list) else [])
    items = list(items)
    logging.info(f'processing {len(items)} liveflow entries')

    by_symbol_strike = defaultdict(lambda: {'volume': 0, 'value': 0, 'spot_sum': 0, 'spot_count': 0, 'count': 0, 'expiry': None, 'option_type': None})
    by_symbol_total = defaultdict(int)

    now = datetime.now(tz=timezone.utc)
    for f in items:
        if not isinstance(f, dict): continue
        sym = f.get('Symbol')
        strike = f.get('Strike')
        opt_type = f.get('OptionType')
        expiry = f.get('Expiry')
        vol = f.get('Volume', 0) or 0
        val = f.get('Value', 0) or 0
        spot = f.get('Spot', 0) or 0
        if not sym or strike is None: continue
        # Filter to calls within DTE
        if opt_type and 'call' not in str(opt_type).lower(): continue
        try:
            if expiry:
                exp_dt = datetime.fromtimestamp(int(expiry)/1000.0 if expiry > 1e12 else int(expiry), tz=timezone.utc)
                dte = (exp_dt - now).days
                if dte < 0 or dte > MAX_DTE_DAYS: continue
        except: continue
        try: vol = float(vol); val = float(val); spot = float(spot); strike = float(strike)
        except: continue
        key = (sym, strike, expiry)
        by_symbol_strike[key]['volume'] += vol
        by_symbol_strike[key]['value'] += val
        if spot > 0:
            by_symbol_strike[key]['spot_sum'] += spot
            by_symbol_strike[key]['spot_count'] += 1
        by_symbol_strike[key]['count'] += 1
        by_symbol_strike[key]['option_type'] = opt_type
        by_symbol_strike[key]['expiry'] = expiry
        by_symbol_total[sym] += vol

    candidates = []
    for (sym, strike, expiry), agg in by_symbol_strike.items():
        if by_symbol_total[sym] < MIN_TOTAL_VOLUME: continue
        concentration = agg['volume'] / by_symbol_total[sym] if by_symbol_total[sym] > 0 else 0
        if concentration < CONCENTRATION_MIN: continue
        avg_spot = agg['spot_sum'] / agg['spot_count'] if agg['spot_count'] > 0 else 0
        strike_distance = abs(strike - avg_spot) / avg_spot * 100 if avg_spot > 0 else 999
        if strike_distance > 5: continue  # within 5% of spot
        candidates.append({
            'symbol': sym,
            'strike': strike,
            'expiry': expiry,
            'concentrated_volume': int(agg['volume']),
            'symbol_total_volume': int(by_symbol_total[sym]),
            'concentration_pct': round(concentration * 100, 1),
            'sweep_count': agg['count'],
            'total_value_usd': round(agg['value'], 0),
            'avg_spot': round(avg_spot, 2),
            'strike_distance_pct': round(strike_distance, 2),
        })
    candidates.sort(key=lambda x: -x['concentrated_volume'])

    out_data = {
        'generated_at': datetime.now(tz=timezone.utc).isoformat(),
        'total_liveflows_processed': len(items),
        'candidates_found': len(candidates),
        'top_20': candidates[:20],
    }
    OUT.write_text(json.dumps(out_data, indent=1, default=str))
    logging.info(f'gamma candidates: {len(candidates)}, top: {[c["symbol"] for c in candidates[:5]]}')
    return candidates

def post_summary(candidates):
    if not candidates: return
    state = json.loads(STATE.read_text()) if STATE.exists() else {'last_post': 0, 'last_top5': []}
    now = int(time.time())
    if now - state.get('last_post', 0) < 900: return
    top5_now = [f"{c['symbol']}:{c['strike']}" for c in candidates[:5]]
    if top5_now == state.get('last_top5', []): return

    lines = ['**Gamma Concentration Alert**', f'_{len(candidates)} call walls within 5% of spot_', '']
    for c in candidates[:5]:
        lines.append(f'**{c["symbol"]}** ${c["strike"]:g}C: {c["concentration_pct"]}% of {c["symbol_total_volume"]:,} contracts')
        lines.append(f'  spot ${c["avg_spot"]:.2f}, distance {c["strike_distance_pct"]:.1f}%, value ${c["total_value_usd"]:,.0f}')

    msg = '\n'.join(lines)

    def _card():
        try:
            import sys, os
            sys.path.insert(0, os.path.expanduser('~/05_AUTOMATION/scripts/lib'))
            import ops_card
        except Exception:
            return False
        rows = [{'label': f'{c["symbol"]} ${c["strike"]:g}C',
                 'value': f'{c["concentration_pct"]}% · ${c["total_value_usd"]/1e6:.1f}M · {c["strike_distance_pct"]:+.1f}%',
                 'state': 'crit' if c['concentration_pct'] >= 60 else 'warn'} for c in candidates[:6]]
        spec = {'bot': 'GAMMA', 'theme': 2, 'title': 'GAMMA SQUEEZE', 'glyph': 'signal',
                'subtitle': f'{len(candidates)} call walls <5% of spot · {ops_card.now_et()}',
                'status': 'warn', 'status_text': f'{len(candidates)} WALLS', 'rows': rows,
                'footer': 'gamma concentration · 15m'}
        summary = '⚡ **Gamma Concentration** — ' + ', '.join(f'{c["symbol"]} ${c["strike"]:g}C' for c in candidates[:5])
        try:
            return ops_card.render_and_post(spec, WEBHOOK, summary).startswith('card:')
        except Exception:
            return False

    ok = _card()
    if not ok:
        try:
            r = requests.post(WEBHOOK, json={'content': msg[:1900]}, timeout=10)
            ok = r.status_code in (200, 204)
        except Exception as e:
            logging.warning(f'post err: {e}'); ok = False
    if ok:
        state['last_post'] = now
        state['last_top5'] = top5_now
        STATE.write_text(json.dumps(state))
        logging.info('posted gamma summary')

def main():
    logging.info('gamma_squeeze starting')
    while True:
        try:
            candidates = cycle()
            post_summary(candidates)
        except Exception as e:
            logging.error(f'cycle err: {e}', exc_info=True)
        time.sleep(900)  # 15 min

if __name__ == '__main__':
    main()
