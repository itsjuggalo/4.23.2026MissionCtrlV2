# Normalize line endings: store LF in the repo and check out LF everywhere, so
# editing files from the Windows side (via \\wsl$) no longer churns the whole tree.
* text=auto eol=lf

# Binary types — never normalize / never diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.apk  binary
*.sqlite binary
*.sqlite-wal binary
*.sqlite-shm binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
