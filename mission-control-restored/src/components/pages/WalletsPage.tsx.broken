'use client';
import { useState, useEffect } from 'react';

const fmt = (n: number) => {
  if (!n && n !== 0) return '0';
  const abs = Math.abs(n);
  if (abs >= 1e6) return (n / 1e6).toFixed(2) + 'M';
  if (abs >= 1e3) return (n / 1e3).toFixed(1) + 'K';
  return n.toLocaleString('en-US', { maximumFractionDigits: 0 });
};
const fmtFull = (n: number) => (n || 0).toLocaleString('en-US', { maximumFractionDigits: 0 });
const fmtQty = (n: number) => {
  if (!n && n !== 0) return '0';
  const abs = Math.abs(n);
  if (abs < 1) return n.toFixed(4);
  if (abs < 100) return n.toFixed(2);
  return Math.round(n).toString();
};
const timeAgo = (ts?: number) => {
  if (!ts) return '—';
  const s = Math.floor((Date.now() - ts) / 1000);
  if (s < 60) return `${s}s ago`;
  const m = Math.floor(s / 60);
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  return `${Math.floor(h / 24)}d ago`;
};

const isPaper = (w: any): boolean => {
  const name = (w.name || '').toLowerCase();
  const badge = (w.badge || '').toUpperCase();
  if (badge === 'LIVE') return false;
  if (badge === 'PAPER') return true;
  if (name.includes('alpaca')) return true;
  if (name.includes('go-trader') || name.includes('gotrader')) return true;
  if (name.includes('hyperliquid') && (w.notes || '').toLowerCase().includes('go-trader')) return true;
  return false;
};

const initialLetter = (name: string): string => (name || '?').charAt(0).toUpperCase();

const accentFor = (w: any): { bg: string; fg: string } => {
  const name = (w.name || '').toLowerCase();
  if (name.includes('hyperliquid')) return { bg: '#2d1a3a', fg: '#ce93d8' };
  if (name.includes('alpaca'))      return { bg: '#1a3a4a', fg: '#4fc3f7' };
  if (name.includes('coinbase'))    return { bg: '#1a2a3a', fg: '#4fc3f7' };
  if (name.includes('robinhood'))   return { bg: '#1a3a1a', fg: '#66bb6a' };
  return { bg: '#1a3a4a', fg: '#4fc3f7' };
};

export default function WalletsPage() {
  const [authenticated, setAuthenticated] = useState(false);
  const [checking, setChecking] = useState(true);
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);
  const [wallets, setWallets] = useState<any[]>([]);

  useEffect(() => {
    fetch('/api/wallets')
      .then(r => r.ok ? r.json() : Promise.reject())
      .then(data => { setWallets(data.wallets || []); setAuthenticated(true); })
      .catch(() => {})
      .finally(() => setChecking(false));
  }, []);

  const handleLogin = async () => {
    setLoading(true); setError('');
    try {
      const res = await fetch('/api/wallet-auth', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      });
      if (res.ok) {
        const wRes = await fetch('/api/wallets');
        const data = await wRes.json();
        setWallets(data.wallets || []);
        setAuthenticated(true);
      } else {
        setError('Incorrect password');
      }
    } catch { setError('Connection error'); }
    finally { setLoading(false); }
  };

  if (checking) {
    return <div style={{ padding: '60px 40px', textAlign: 'center', color: '#607d8b', fontFamily: 'var(--font-mc-mono)' }}>Checking access...</div>;
  }

  if (!authenticated) {
    return (
      <div style={{ padding: '60px 40px', maxWidth: '400px', margin: '0 auto' }}>
        <div style={{ background: 'linear-gradient(180deg, #0a1929 0%, #0d1420 100%)', border: '1px solid #1a3a4a', borderRadius: '10px', padding: '36px 32px' }}>
          <div style={{ fontSize: 'var(--mc-font-xl)', fontWeight: 700, color: '#e0e0e0', fontFamily: 'var(--font-mc-mono)', marginBottom: '8px', letterSpacing: '2px' }}>WALLETS</div>
          <div style={{ fontSize: 'var(--mc-font-sm)', color: '#607d8b', fontFamily: 'var(--font-mc-mono)', marginBottom: '24px', letterSpacing: '1px' }}>AUTHORIZATION REQUIRED</div>
          <input type="password" value={password} onChange={(e) => setPassword(e.target.value)} onKeyDown={(e) => e.key === 'Enter' && handleLogin()} placeholder="Password"
            style={{ width: '100%', padding: '14px 16px', background: '#0a1115', border: '1px solid #1a3a4a', borderRadius: '8px', color: '#e0e0e0', fontSize: 'var(--mc-font-md)', fontFamily: 'var(--font-mc-mono)', marginBottom: '14px' }}
          />
          {error && <div style={{ color: '#ef5350', fontSize: 'var(--mc-font-sm)', marginBottom: '12px', fontFamily: 'var(--font-mc-mono)' }}>{error}</div>}
          <button onClick={handleLogin} disabled={loading || !password}
            style={{ width: '100%', padding: '14px', background: loading ? '#1a3a4a' : 'linear-gradient(135deg, #1a3a4a, #0a1929)', color: '#4fc3f7', border: '1px solid #4fc3f744', borderRadius: '8px', fontSize: 'var(--mc-font-sm)', fontWeight: 700, fontFamily: 'var(--font-mc-mono)', letterSpacing: '2px', cursor: loading ? 'wait' : 'pointer', opacity: !password ? 0.4 : 1 }}>
            {loading ? 'AUTHENTICATING...' : 'AUTHENTICATE'}
          </button>
        </div>
      </div>
    );
  }

  // === Split wallets by paper/live ===
  const paperWallets = wallets.filter(isPaper);
  const liveWallets = wallets.filter(w => !isPaper(w));

  const paperTotal = paperWallets.reduce((s, w) => s + (w.balance || 0), 0);
  const liveTotal  = liveWallets.reduce((s, w) => s + (w.balance || 0), 0);
  const totalBalance = paperTotal + liveTotal;

  const paperPct = totalBalance > 0 ? (paperTotal / totalBalance * 100) : 0;
  const livePct  = totalBalance > 0 ? (liveTotal  / totalBalance * 100) : 0;

  return (
    <div style={{ padding: '24px', maxWidth: '1400px', margin: '0 auto', fontFamily: 'var(--font-mc-mono)' }}>

      {/* === COMMAND BAR === */}
      <div style={{
        display: 'grid', gridTemplateColumns: '1fr auto 1fr',
        gap: '16px', alignItems: 'center',
        marginBottom: '20px', padding: '18px 22px',
        background: 'linear-gradient(180deg, #0d1420 0%, #0a1115 100%)',
        border: '1px solid #1a2332', borderRadius: '8px',
      }}>
        <div>
          <div style={{ fontSize: 'var(--mc-font-badge)', color: '#607d8b', letterSpacing: '2px', marginBottom: '6px' }}>TOTAL EQUITY</div>
          <div style={{ fontSize: '28px', fontWeight: 800, color: '#e0e0e0', lineHeight: 1 }}>${fmtFull(totalBalance)}</div>
          <div style={{ fontSize: 'var(--mc-font-xs)', color: '#607d8b', marginTop: '6px' }}>{wallets.length} accounts connected</div>
        </div>
        <div style={{ display: 'flex', gap: '20px', padding: '0 18px', borderLeft: '1px solid #1a2332', borderRight: '1px solid #1a2332' }}>
          <div style={{ textAlign: 'center' }}>
            <div style={{ fontSize: 'var(--mc-font-badge)', color: '#607d8b', letterSpacing: '1.5px', marginBottom: '4px' }}>PAPER</div>
            <div style={{ fontSize: 'var(--mc-font-md)', fontWeight: 700, color: '#90a4ae' }}>${fmt(paperTotal)}</div>
            <div style={{ fontSize: 'var(--mc-font-badge)', color: '#607d8b' }}>{paperPct.toFixed(0)}%</div>
          </div>
          <div style={{ textAlign: 'center' }}>
            <div style={{ fontSize: 'var(--mc-font-badge)', color: '#607d8b', letterSpacing: '1.5px', marginBottom: '4px' }}>LIVE</div>
            <div style={{ fontSize: 'var(--mc-font-md)', fontWeight: 700, color: '#66bb6a' }}>${fmt(liveTotal)}</div>
            <div style={{ fontSize: 'var(--mc-font-badge)', color: '#607d8b' }}>{livePct.toFixed(0)}%</div>
          </div>
        </div>
        <div>
          <div style={{ fontSize: 'var(--mc-font-badge)', color: '#607d8b', letterSpacing: '2px', marginBottom: '6px' }}>ACCOUNTS</div>
          <div style={{ fontSize: 'var(--mc-font-md)', color: '#e0e0e0' }}>{paperWallets.length} paper · {liveWallets.length} live</div>
          <div style={{ fontSize: 'var(--mc-font-xs)', color: '#607d8b', marginTop: '4px' }}>
            {wallets.filter(w => w.status === 'error').length > 0
              ? <span style={{ color: '#ef5350' }}>{wallets.filter(w => w.status === 'error').length} error(s)</span>
              : <span style={{ color: '#66bb6a' }}>all healthy</span>}
          </div>
        </div>
      </div>

      {/* === TWO COLUMNS === */}
      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '16px' }}>
        {/* PAPER COLUMN */}
        <WalletColumn
          label="PAPER"
          total={paperTotal}
          accentColor="#90a4ae"
          wallets={paperWallets}
          showGlow={false}
        />
        {/* LIVE COLUMN */}
        <WalletColumn
          label="LIVE"
          total={liveTotal}
          accentColor="#66bb6a"
          wallets={liveWallets}
          showGlow={true}
        />
      </div>

    </div>
  );
}

function WalletColumn({ label, total, accentColor, wallets, showGlow }: {
  label: string; total: number; accentColor: string; wallets: any[]; showGlow: boolean;
}) {
  return (
    <div>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '10px', padding: '0 2px' }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
          <div style={{
            width: '6px', height: '6px', borderRadius: '50%',
            background: accentColor,
            boxShadow: showGlow ? `0 0 6px ${accentColor}` : undefined,
          }} />
          <div style={{ fontSize: 'var(--mc-font-xs)', fontWeight: 700, color: accentColor, letterSpacing: '2.5px' }}>
            {label} · ${fmtFull(total)}
          </div>
        </div>
        <div style={{ fontSize: 'var(--mc-font-badge)', color: '#607d8b' }}>{wallets.length} {wallets.length === 1 ? 'account' : 'accounts'}</div>
      </div>
      <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
        {wallets.map((w, i) => <WalletCard key={i} w={w} live={!showGlow ? false : true} />)}
        {wallets.length === 0 && (
          <div style={{ padding: '30px', textAlign: 'center', color: '#607d8b', fontSize: 'var(--mc-font-xs)', background: '#0a1115', border: '1px dashed #1a3a4a', borderRadius: '6px' }}>
            No {label.toLowerCase()} accounts
          </div>
        )}
      </div>
    </div>
  );
}

function WalletCard({ w, live }: { w: any; live: boolean }) {
  const balance = w.balance || 0;
  const cash = w.cash || 0;
  const bp = w.buying_power || 0;
  const isError = w.status === 'error';
  const positions = w.positions || [];
  const accent = accentFor(w);
  const changePct = w.change_pct ?? w.day_change_pct ?? null;
  const changeAbs = w.change_abs ?? w.day_change ?? null;
  const changeColor = changePct != null ? (changePct >= 0 ? '#66bb6a' : '#ef5350') : '#607d8b';
  const subBadge = (w.notes || '').toLowerCase().includes('go-trader') ? 'go-trader'
    : (w.name || '').toLowerCase().includes('crypto') ? 'crypto'
    : (w.name || '').toLowerCase().includes('stocks') ? 'stocks'
    : (w.name || '').toLowerCase().includes('personal') ? 'personal'
    : null;

  return (
    <div style={{
      background: isError ? '#14080a' : '#0d1420',
      border: isError ? '1px solid #ef535066' : (live ? '1px solid #66bb6a33' : '1px solid #1a3a4a'),
      borderRadius: '6px',
      padding: '14px 16px',
    }}>
      {/* Header row */}
      <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: positions.length > 0 || cash > 0 || bp > 0 ? '10px' : '0' }}>
        <div style={{ flex: 1, minWidth: 0 }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '6px', marginBottom: '2px' }}>
            <div style={{
              width: '18px', height: '18px', background: accent.bg, borderRadius: '3px',
              display: 'flex', alignItems: 'center', justifyContent: 'center',
              fontSize: '9px', fontWeight: 700, color: accent.fg,
            }}>{initialLetter(w.name)}</div>
            <span style={{ fontSize: 'var(--mc-font-sm)', fontWeight: 700, color: '#e0e0e0' }}>{w.name}</span>
            {subBadge && (
              <span style={{
                fontSize: '9px', padding: '1px 5px', background: accent.bg, color: accent.fg,
                borderRadius: '2px', letterSpacing: '0.3px',
              }}>{subBadge}</span>
            )}
            {isError && (
              <span style={{
                fontSize: '9px', padding: '1px 5px', background: '#3a1a1a', color: '#ef5350',
                borderRadius: '2px', letterSpacing: '0.3px',
              }}>error</span>
            )}
            <span style={{
              width: '5px', height: '5px', borderRadius: '50%',
              background: isError ? '#ef5350' : '#66bb6a',
              marginLeft: 'auto',
            }} />
          </div>
          <div style={{ fontSize: '9px', color: isError ? '#ef5350' : '#607d8b', marginLeft: '24px' }}>
            {isError ? 'API unreachable' : (
              positions.length > 0 ? `${positions.length} ${positions.length === 1 ? 'position' : 'positions'}` : w.type || ''
            )}
            {' · '}{timeAgo(w.updated_at || w.last_sync)}
          </div>
        </div>
        <div style={{ textAlign: 'right', marginLeft: '12px' }}>
          {isError ? (
            <>
              <div style={{ fontSize: 'var(--mc-font-md)', fontWeight: 700, color: '#607d8b', lineHeight: 1 }}>—</div>
              <div style={{ fontSize: '9px', color: '#ef5350', marginTop: '4px', cursor: 'pointer', textDecoration: 'underline' }}
                onClick={() => window.location.reload()}>retry</div>
            </>
          ) : (
            <>
              <div style={{ fontSize: 'var(--mc-font-md)', fontWeight: 700, color: '#e0e0e0', lineHeight: 1 }}>${fmtFull(balance)}</div>
              {changeAbs != null && (
                <div style={{ fontSize: '9px', color: changeColor, marginTop: '4px' }}>
                  {changeAbs >= 0 ? '+' : ''}${fmtFull(Math.abs(changeAbs))} ({changePct >= 0 ? '+' : ''}{changePct?.toFixed(1)}%)
                </div>
              )}
            </>
          )}
        </div>
      </div>

      {/* Context stats row */}
      {!isError && (cash > 0 || bp > 0) && (
        <div style={{
          display: 'grid', gridTemplateColumns: bp > 0 && bp !== cash ? '1fr 1fr' : '1fr',
          gap: '6px', padding: '8px 10px', background: '#0a1115', borderRadius: '4px',
          marginBottom: positions.length > 0 ? '10px' : '0', fontSize: '9px',
        }}>
          {cash > 0 && <div><span style={{ color: '#607d8b' }}>CASH </span><span style={{ color: '#e0e0e0' }}>${fmtFull(cash)}</span></div>}
          {bp > 0 && bp !== cash && <div><span style={{ color: '#607d8b' }}>BP </span><span style={{ color: '#4fc3f7' }}>${fmtFull(bp)}</span></div>}
        </div>
      )}

      {/* Holdings grid */}
      {!isError && positions.length > 0 && (
        <>
          <div style={{ fontSize: '9px', color: '#607d8b', letterSpacing: '1px', marginBottom: '6px' }}>HOLDINGS</div>
          <div style={{ display: 'grid', gap: '4px' }}>
            {positions.slice(0, 8).map((p: any, j: number) => {
              const isStock = p.type === 'stock';
              const symColor = isStock ? '#4fc3f7' : '#ce93d8';
              const pctRet = p.pct_change ?? (p.avg_cost > 0 ? (p.price - p.avg_cost) / p.avg_cost * 100 : null);
              const pctColor = pctRet != null ? (pctRet >= 0 ? '#66bb6a' : '#ef5350') : '#607d8b';
              return (
                <div key={j} style={{
                  display: 'grid', gridTemplateColumns: '46px 1fr auto auto',
                  gap: '8px', padding: '6px 8px', background: '#0a1115', borderRadius: '3px',
                  alignItems: 'center', fontSize: '10px',
                }}>
                  <span style={{ fontWeight: 700, color: symColor }}>{p.symbol}</span>
                  <span style={{ color: '#607d8b', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                    {fmtQty(p.quantity)} {isStock ? 'sh' : ''}{p.avg_cost > 0 ? ` @ $${fmtQty(p.avg_cost)}` : ''}
                  </span>
                  <span style={{ fontWeight: 700, color: '#e0e0e0' }}>${fmt(p.equity || 0)}</span>
                  <span style={{ color: pctColor }}>{pctRet != null ? `${pctRet >= 0 ? '+' : ''}${pctRet.toFixed(1)}%` : '—'}</span>
                </div>
              );
            })}
            {positions.length > 8 && (
              <div style={{ fontSize: '9px', color: '#607d8b', textAlign: 'center', padding: '4px' }}>
                +{positions.length - 8} more
              </div>
            )}
          </div>
        </>
      )}

    </div>
  );
}
