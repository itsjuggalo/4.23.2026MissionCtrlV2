server {
    server_name missionctrl.serveftp.com;

    # Allow Let's Encrypt validation
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location /webhook/ {
        proxy_pass http://127.0.0.1:8420;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /signals/ {
        proxy_pass http://127.0.0.1:8420;
        proxy_set_header Host $host;
    }

    location /health {
        proxy_pass http://127.0.0.1:8420;
    }

    location / {
        proxy_pass http://127.0.0.1:3033;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/missionctrl.serveftp.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/missionctrl.serveftp.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = missionctrl.serveftp.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name missionctrl.serveftp.com;
    return 404; # managed by Certbot


}