[Unit]
Description=Kronos WebUI (Flask + Plotly on :7070)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/itsju/04_RESEARCH/Kronos/webui
ExecStart=/home/itsju/02_DATA/mc-kb/.venv/bin/python -c "import sys; sys.path.insert(0,'..'); from app import app; app.run(host='0.0.0.0', port=7070)"
Restart=always
RestartSec=10
Environment=HOME=/home/itsju
Environment=PYTHONPATH=/home/itsju/04_RESEARCH/Kronos

[Install]
WantedBy=default.target
