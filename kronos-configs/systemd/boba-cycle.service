[Unit]
Description=Boba Decision Cycle
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/itsju/05_AUTOMATION/scripts/boba_decision_cycle.py
WorkingDirectory=/home/itsju/05_AUTOMATION/scripts
