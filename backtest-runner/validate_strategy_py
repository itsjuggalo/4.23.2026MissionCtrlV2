#!/usr/bin/env python3
"""
Pine vs Python strategy validator - Item 37.

Takes a strategy spec + Pine-claimed stats, runs same logic in backtrader on
yfinance bars, prints delta. Flags discrepancies > 10%.

Three failure modes this catches:
  1. Pine lookahead bias (signal uses future bar data)
  2. TradingView bar-magnification optimistic fills
  3. Pine math errors that compile clean but produce wrong P&L

Built-in strategy library (extend as new Pine strategies are validated):
  supertrend - SuperTrend ATR period + factor
  rsi-meanrev - RSI mean reversion (oversold/overbought thresholds)

Usage:
  python3 validate_strategy_py supertrend AAPL 1H 14 3.0 \
      --start 2025-04-01 --end 2026-04-01 \
      --pine-pf 1.73 --pine-return 18.5 --pine-dd 15.33 --pine-wr 50

Output:
  Strategy: supertrend AAPL 1H ATR=14 factor=3.0
  Period: 2025-04-01 to 2026-04-01
  Bars: 1340
  Trades: 47
  Python PF:     1.68 (Pine 1.73, delta -2.9%)  OK
  Python return: 17.2% (Pine 18.5%, delta -7.0%)  OK
  Python DD:     16.1% (Pine 15.33%, delta +5.0%)  OK
  Python WR:     48.9% (Pine 50%, delta -2.2%)  OK
  VERDICT: Pine claims look real, deltas under 10%
"""
import argparse
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

import backtrader as bt
import yfinance as yf
import pandas as pd

STATE_DIR = Path("/home/ubuntu/.openclaw/state/backtest_validator")
STATE_DIR.mkdir(parents=True, exist_ok=True)


# ============ STRATEGIES ============

class SuperTrendStrategy(bt.Strategy):
    """SuperTrend - flips long/short on band crosses. Mike's primary Pine pattern."""
    params = (
        ("atr_period", 14),
        ("factor", 3.0),
    )

    def __init__(self):
        self.atr = bt.indicators.AverageTrueRange(period=self.p.atr_period)
        self.hl2 = (self.data.high + self.data.low) / 2
        self.upper_band = self.hl2 + self.p.factor * self.atr
        self.lower_band = self.hl2 - self.p.factor * self.atr
        self.trend = 1  # 1 = up, -1 = down
        self.last_st = None
        self.trade_count = 0
        self.win_count = 0
        self.peak_value = 0
        self.max_dd = 0

    def next(self):
        # Compute SuperTrend value for current bar
        if self.last_st is None:
            curr_st = self.lower_band[0]
        else:
            if self.data.close[-1] > self.last_st:
                # uptrend continues
                curr_st = max(self.lower_band[0], self.last_st)
            else:
                curr_st = min(self.upper_band[0], self.last_st)
            # flip detection
            if self.data.close[0] > self.last_st and self.trend == -1:
                self.trend = 1
            elif self.data.close[0] < self.last_st and self.trend == 1:
                self.trend = -1

        self.last_st = curr_st

        # Trade on flips
        if self.trend == 1 and not self.position:
            self.buy(size=int(self.broker.getcash() / self.data.close[0] * 0.95))
        elif self.trend == -1 and self.position:
            self.close()

        # Track DD
        v = self.broker.getvalue()
        if v > self.peak_value:
            self.peak_value = v
        if self.peak_value > 0:
            dd = (self.peak_value - v) / self.peak_value * 100
            if dd > self.max_dd:
                self.max_dd = dd

    def notify_trade(self, trade):
        if trade.isclosed:
            self.trade_count += 1
            if trade.pnl > 0:
                self.win_count += 1


class RSIMeanRevStrategy(bt.Strategy):
    """RSI mean reversion - buy <30, sell >70."""
    params = (
        ("rsi_period", 14),
        ("oversold", 30),
        ("overbought", 70),
    )

    def __init__(self):
        self.rsi = bt.indicators.RSI(period=self.p.rsi_period)
        self.trade_count = 0
        self.win_count = 0
        self.peak_value = 0
        self.max_dd = 0

    def next(self):
        if not self.position and self.rsi[0] < self.p.oversold:
            self.buy(size=int(self.broker.getcash() / self.data.close[0] * 0.95))
        elif self.position and self.rsi[0] > self.p.overbought:
            self.close()
        v = self.broker.getvalue()
        if v > self.peak_value:
            self.peak_value = v
        if self.peak_value > 0:
            dd = (self.peak_value - v) / self.peak_value * 100
            if dd > self.max_dd:
                self.max_dd = dd

    def notify_trade(self, trade):
        if trade.isclosed:
            self.trade_count += 1
            if trade.pnl > 0:
                self.win_count += 1


STRATEGIES = {
    "supertrend": SuperTrendStrategy,
    "rsi-meanrev": RSIMeanRevStrategy,
}


# ============ DATA ============

def fetch_bars(ticker, timeframe, start, end):
    """Fetch OHLCV from yfinance. Map TV-style timeframe to yfinance interval."""
    tf_map = {
        "1m": "1m", "5m": "5m", "15m": "15m", "30m": "30m",
        "1H": "1h", "4H": "1h",  # 4H not native, would need resample
        "1D": "1d", "1W": "1wk",
    }
    interval = tf_map.get(timeframe, "1d")
    df = yf.download(ticker, start=start, end=end, interval=interval, progress=False, auto_adjust=False)
    if df.empty:
        raise RuntimeError(f"no bars for {ticker} {timeframe} {start} to {end}")
    # backtrader expects single-level columns
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.get_level_values(0)
    df = df.rename(columns=str.lower)
    return df


# ============ RUNNER ============

def run_backtest(strategy_name, ticker, timeframe, start, end, **strat_params):
    """Run backtest, return stats dict."""
    StrategyClass = STRATEGIES[strategy_name]
    df = fetch_bars(ticker, timeframe, start, end)

    cerebro = bt.Cerebro()
    cerebro.addstrategy(StrategyClass, **strat_params)
    data_feed = bt.feeds.PandasData(dataname=df)
    cerebro.adddata(data_feed)
    cerebro.broker.setcash(100_000)
    cerebro.broker.setcommission(commission=0.001)

    cerebro.addanalyzer(bt.analyzers.TradeAnalyzer, _name="trades")
    cerebro.addanalyzer(bt.analyzers.SharpeRatio, _name="sharpe")
    cerebro.addanalyzer(bt.analyzers.DrawDown, _name="drawdown")

    initial = cerebro.broker.getvalue()
    results = cerebro.run()
    strat = results[0]
    final = cerebro.broker.getvalue()

    trades_an = strat.analyzers.trades.get_analysis()
    dd_an = strat.analyzers.drawdown.get_analysis()

    total_won = trades_an.get("won", {}).get("total", 0)
    total_lost = trades_an.get("lost", {}).get("total", 0)
    total = total_won + total_lost
    won_pnl = trades_an.get("won", {}).get("pnl", {}).get("total", 0) or 0
    lost_pnl = abs(trades_an.get("lost", {}).get("pnl", {}).get("total", 0) or 0)

    pf = (won_pnl / lost_pnl) if lost_pnl > 0 else (won_pnl if won_pnl > 0 else 0)
    return_pct = (final - initial) / initial * 100
    wr_pct = (total_won / total * 100) if total > 0 else 0
    max_dd_pct = dd_an.get("max", {}).get("drawdown", 0) or strat.max_dd

    return {
        "strategy": strategy_name,
        "ticker": ticker,
        "timeframe": timeframe,
        "period": f"{start} to {end}",
        "bars": len(df),
        "trades": total,
        "pf": round(pf, 3),
        "return_pct": round(return_pct, 2),
        "max_dd_pct": round(max_dd_pct, 2),
        "wr_pct": round(wr_pct, 2),
        "initial": initial,
        "final": round(final, 2),
        "params": strat_params,
    }


def compare_pine(stats, pine_pf=None, pine_return=None, pine_dd=None, pine_wr=None):
    """Compare Python stats against Pine claims, flag if delta > 10%."""
    print()
    print(f"Strategy: {stats['strategy']} {stats['ticker']} {stats['timeframe']}")
    print(f"Params:   {stats['params']}")
    print(f"Period:   {stats['period']}")
    print(f"Bars:     {stats['bars']}")
    print(f"Trades:   {stats['trades']}")
    print()

    deltas = []

    def flag(name, py_val, pine_val):
        if pine_val is None:
            print(f"  Python {name:<12} {py_val}    (no Pine value to compare)")
            return None
        if pine_val == 0:
            delta_pct = 0
        else:
            delta_pct = (py_val - pine_val) / abs(pine_val) * 100
        marker = "  OK" if abs(delta_pct) <= 10 else "  FLAG > 10%"
        print(f"  Python {name:<12} {py_val:<8} (Pine {pine_val}, delta {delta_pct:+.1f}%){marker}")
        return abs(delta_pct)

    d = flag("PF:", stats["pf"], pine_pf);
    if d is not None: deltas.append(d)
    d = flag("Return %:", stats["return_pct"], pine_return)
    if d is not None: deltas.append(d)
    d = flag("Max DD %:", stats["max_dd_pct"], pine_dd)
    if d is not None: deltas.append(d)
    d = flag("Win Rate %:", stats["wr_pct"], pine_wr)
    if d is not None: deltas.append(d)

    print()
    if not deltas:
        verdict = "NO PINE VALUES - python-only baseline run"
    elif max(deltas) <= 10:
        verdict = "Pine claims look real, all deltas under 10%"
    elif max(deltas) <= 25:
        verdict = "Some deltas 10-25% - investigate Pine fill model or lookahead"
    else:
        verdict = "MAJOR DISCREPANCY > 25% - likely Pine bug or unrealistic fills"

    print(f"VERDICT: {verdict}")
    return stats, verdict


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("strategy", choices=list(STRATEGIES.keys()))
    ap.add_argument("ticker")
    ap.add_argument("timeframe", help="1m 5m 15m 30m 1H 4H 1D 1W")
    ap.add_argument("--atr-period", type=int, default=14)
    ap.add_argument("--factor", type=float, default=3.0)
    ap.add_argument("--rsi-period", type=int, default=14)
    ap.add_argument("--oversold", type=int, default=30)
    ap.add_argument("--overbought", type=int, default=70)
    ap.add_argument("--start", default="2025-04-01")
    ap.add_argument("--end", default="2026-04-01")
    ap.add_argument("--pine-pf", type=float)
    ap.add_argument("--pine-return", type=float)
    ap.add_argument("--pine-dd", type=float)
    ap.add_argument("--pine-wr", type=float)
    ap.add_argument("--save", action="store_true", help="Save run to state log")
    args = ap.parse_args()

    if args.strategy == "supertrend":
        params = {"atr_period": args.atr_period, "factor": args.factor}
    else:
        params = {"rsi_period": args.rsi_period, "oversold": args.oversold, "overbought": args.overbought}

    stats = run_backtest(args.strategy, args.ticker, args.timeframe, args.start, args.end, **params)
    stats_out, verdict = compare_pine(
        stats,
        pine_pf=args.pine_pf,
        pine_return=args.pine_return,
        pine_dd=args.pine_dd,
        pine_wr=args.pine_wr,
    )

    if args.save:
        log = STATE_DIR / "validation_log.jsonl"
        with log.open("a") as f:
            f.write(json.dumps({
                "ts": datetime.now(timezone.utc).isoformat(),
                "stats": stats_out,
                "pine_pf": args.pine_pf,
                "pine_return": args.pine_return,
                "pine_dd": args.pine_dd,
                "pine_wr": args.pine_wr,
                "verdict": verdict,
            }) + "\n")
        print(f"\n[saved] {log}")


if __name__ == "__main__":
    main()
