#!/usr/bin/env python3
"""
pnl_tracker - Nightly P&L summary for both disciplined accounts.
Fires 5 PM ET Mon-Fri after market close.
Reports today's trades, realized P&L, current equity, total since launch.
Posts summary to TradeFlow Discord + saves to state file for dashboard.
"""
import json, sys, time, requests
from datetime import datetime, date, timedelta
from pathlib import Path

sys.path.insert(0, '/home/ubuntu/scripts/disciplined-decisions')
import core

WEBHOOK = 'https://discordapp.com/api/webhooks/1497661681126609008/tlS_qnTSq4Uef8AUVpllp2vwC3sJ7u0BHt2_WcoJz5y75dnh3cgHpkhOn59zGlkWmyPk'
STARTING_CAPITAL = 1000.00
PNL_LOG = Path('/home/ubuntu/.openclaw/workspace/state/disciplined/pnl_history_jsonl')
PNL_LOG.parent.mkdir(parents=True, exist_ok=True)


def summarize_account(agent_name, key_file, secret_file):
    key = core.read_secret(key_file)
    secret = core.read_secret(secret_file)
    if not key or not secret:
        return None
    acct = core.get_account_state(key, secret)
    if not acct:
        return None
    
    equity = float(acct.get('equity', 0))
    cash = float(acct.get('cash', 0))
    
    # Get today's closed orders
    today = date.today().isoformat()
    closed = core.alpaca_call('/v2/orders', key, secret,
                               params={'status': 'closed', 'limit': 100, 'after': f'{today}T00:00:00Z'}) or []
    if not isinstance(closed, list):
        closed = []
    
    today_buys = [o for o in closed if o.get('side') == 'buy' and o.get('status') == 'filled']
    today_sells = [o for o in closed if o.get('side') == 'sell' and o.get('status') == 'filled']
    
    # FIFO match buys to sells per symbol
    realized_pnl = 0
    matches = []
    for sell in today_sells:
        sym = sell.get('symbol')
        sell_price = float(sell.get('filled_avg_price', 0) or 0)
        sell_qty = float(sell.get('filled_qty', 0) or 0)
        if sell_price <= 0 or sell_qty <= 0:
            continue
        # Find matching buy
        for buy in today_buys:
            if buy.get('symbol') == sym:
                buy_price = float(buy.get('filled_avg_price', 0) or 0)
                buy_qty = float(buy.get('filled_qty', 0) or 0)
                if buy_price > 0 and buy_qty > 0:
                    buy_value = buy_price * buy_qty * 100
                    sell_value = sell_price * sell_qty * 100
                    pnl = sell_value - buy_value
                    realized_pnl += pnl
                    matches.append({'sym': sym, 'buy': buy_price, 'sell': sell_price, 'pnl': pnl})
                    today_buys.remove(buy)
                    break
    
    positions = core.get_open_positions(key, secret) or []
    open_pos = []
    for p in positions:
        sym = p.get('symbol')
        qty = abs(int(float(p.get('qty', 0))))
        avg_entry = float(p.get('avg_entry_price', 0))
        market_val = float(p.get('market_value', 0))
        unreal_pnl = float(p.get('unrealized_pl', 0))
        open_pos.append({'sym': sym, 'qty': qty, 'entry': avg_entry, 'unreal_pnl': unreal_pnl})
    
    return {
        'agent': agent_name,
        'equity': equity,
        'cash': cash,
        'starting': STARTING_CAPITAL,
        'total_return_pct': (equity / STARTING_CAPITAL - 1) * 100,
        'today_realized_pnl': realized_pnl,
        'today_matches': matches,
        'open_positions': open_pos,
        'today_buy_count': len([o for o in closed if o.get('side') == 'buy' and o.get('status') == 'filled']),
        'today_sell_count': len([o for o in closed if o.get('side') == 'sell' and o.get('status') == 'filled']),
    }


def main():
    et_now = datetime.now()
    
    boba = summarize_account('boba', 'alpaca-boba-key-id', 'alpaca-boba-secret')
    jazzy = summarize_account('jazzy', 'alpaca-jazzy-key-id', 'alpaca-jazzy-secret')
    
    if not boba and not jazzy:
        print('  no accounts readable')
        return
    
    # Append snapshot to log
    snap = {
        'ts': et_now.isoformat(),
        'boba': boba,
        'jazzy': jazzy,
    }
    with PNL_LOG.open('a') as f:
        f.write(json.dumps(snap) + '\n')
    
    # Build Discord post
    lines = [f'🌙 **NIGHTLY P&L** — {et_now.strftime("%Y-%m-%d %H:%M ET")}', '']
    for label, data in [('Boba', boba), ('Jazzy', jazzy)]:
        if not data:
            continue
        ret_emoji = '🟢' if data['total_return_pct'] >= 0 else '🔴'
        today_emoji = '🟢' if data['today_realized_pnl'] >= 0 else '🔴'
        lines.append(f"**{label}** {ret_emoji}")
        lines.append(f"  Equity: ${data['equity']:,.2f} (start ${data['starting']:,.0f}, {data['total_return_pct']:+.1f}%)")
        lines.append(f"  Today realized: {today_emoji} ${data['today_realized_pnl']:+,.2f}")
        lines.append(f"  Today: {data['today_buy_count']} buys, {data['today_sell_count']} sells")
        if data['open_positions']:
            lines.append(f"  Open positions:")
            for p in data['open_positions']:
                emoji = '🟢' if p['unreal_pnl'] >= 0 else '🔴'
                lines.append(f"    {emoji} {p['sym']} qty={p['qty']} entry=${p['entry']:.2f} unrealized ${p['unreal_pnl']:+.2f}")
        lines.append('')
    
    msg = '\n'.join(lines)
    try:
        r = requests.post(WEBHOOK, json={'content': msg[:1900]}, timeout=10)
        print(f'  posted P&L summary HTTP {r.status_code}')
    except Exception as e:
        print(f'  Discord post failed: {e}')


if __name__ == '__main__':
    main()
