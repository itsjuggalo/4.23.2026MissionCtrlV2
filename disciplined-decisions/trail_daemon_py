#!/usr/bin/env python3
"""
trail_daemon - Continuous 5 percent trailing stop for both Boba and Jazzy.

Logic per open position:
1. Track highest mark price (peak) seen since fill.
2. Desired stop = peak * 0.95 (uniform 5 percent trail across all grades).
3. If desired stop > existing OCO stop, cancel current OCO and submit new one with raised stop.
4. Take profit limit unchanged at +100 percent from entry.
5. Stop NEVER moves down - ratchet-only.

Polls every 1 minute during market hours via cron.
"""
import json, sys, time, logging
from datetime import datetime, timezone
from pathlib import Path
import requests

sys.path.insert(0, '/home/ubuntu/scripts/disciplined-decisions')
import core

logging.basicConfig(level=logging.INFO, format='%(asctime)s [trail] %(message)s', datefmt='%H:%M:%S')
log = logging.getLogger('trail')

STATE_FILE = Path('/home/ubuntu/.openclaw/workspace/state/disciplined/trail_state.json')
STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
WEBHOOK = 'https://discordapp.com/api/webhooks/1497661681126609008/tlS_qnTSq4Uef8AUVpllp2vwC3sJ7u0BHt2_WcoJz5y75dnh3cgHpkhOn59zGlkWmyPk'

# Uniform 5 percent trail across all grades
TRAIL_PCT = 0.95

ACCOUNTS = [
    ('boba', 'alpaca-boba-key-id', 'alpaca-boba-secret'),
    ('jazzy', 'alpaca-jazzy-key-id', 'alpaca-jazzy-secret'),
]


def load_state():
    if not STATE_FILE.exists():
        return {}
    try:
        return json.loads(STATE_FILE.read_text())
    except Exception:
        return {}


def save_state(s):
    STATE_FILE.write_text(json.dumps(s, indent=2))


def get_current_mark(occ):
    """Use Tradier for live option mark price."""
    quote = core.fetch_tradier_quote(occ)
    if not quote:
        return None
    bid, ask = quote.get('bid', 0), quote.get('ask', 0)
    if bid > 0 and ask > 0:
        return (bid + ask) / 2
    return None


def get_open_orders_for_symbol(key, secret, symbol):
    return core.alpaca_call('/v2/orders', key, secret, params={'status': 'open', 'symbols': symbol}) or []


def cancel_order(order_id, key, secret):
    return core.alpaca_call(f'/v2/orders/{order_id}', key, secret, method='DELETE')


def submit_oco_close(occ, qty, stop_price, tp_price, key, secret):
    """
    Options on Alpaca paper do NOT support OCO bracket - submit stop_limit only.
    TP handled by trail ratcheting the stop up as peak rises - no separate TP order needed.
    """
    stop_limit_p = round(max(stop_price * 0.90, 0.01), 2)
    payload = {
        'symbol': occ,
        'qty': str(qty),
        'side': 'sell',
        'type': 'stop_limit',
        'time_in_force': 'gtc',
        'stop_price': str(round(stop_price, 2)),
        'limit_price': str(stop_limit_p),
        'position_intent': 'sell_to_close',
    }
    return core.alpaca_call('/v2/orders', key, secret, method='POST', json=payload)


def post_discord(agent, occ, msg):
    full = f'**{agent.upper()} TRAIL** {occ}\n{msg}'
    try:
        requests.post(WEBHOOK, json={'content': full[:1900]}, timeout=10)
    except Exception:
        pass


def trail_position(agent, key, secret, position, state):
    """Process trailing for one position."""
    occ = position.get('symbol')
    if not occ:
        return
    qty = abs(int(float(position.get('qty', 0))))
    if qty <= 0:
        return
    avg_entry = float(position.get('avg_entry_price', 0))
    if avg_entry <= 0:
        return

    state_key = f'{agent}_{occ}'
    pos_state = state.get(state_key, {
        'occ': occ, 'agent': agent,
        'avg_entry': avg_entry, 'qty': qty,
        'peak_mark': avg_entry,
        'current_stop': round(avg_entry * TRAIL_PCT, 2),
        'first_seen': datetime.now(timezone.utc).isoformat(),
    })

    current_mark = get_current_mark(occ)
    if current_mark is None or current_mark <= 0:
        log.warning(f'  {agent} {occ}: no mark, skip')
        return

    # Update peak if new high seen
    peak = max(pos_state.get('peak_mark', avg_entry), current_mark)
    desired_stop = round(peak * TRAIL_PCT, 2)
    current_stop = pos_state.get('current_stop', round(avg_entry * TRAIL_PCT, 2))

    log.info(f'  {agent} {occ} entry=${avg_entry:.2f} mark=${current_mark:.2f} peak=${peak:.2f} stop now=${current_stop:.2f} want=${desired_stop:.2f}')

    # Only ratchet up - never down
    if desired_stop > current_stop:
        # Cancel existing open OCO/stop orders for this OCC
        open_orders = get_open_orders_for_symbol(key, secret, occ)
        for o in open_orders:
            oid = o.get('id')
            otype = str(o.get('order_type') or o.get('type', '')).lower()
            oclass = o.get('order_class', '')
            if 'stop' in otype or oclass in ('oco', 'bracket'):
                cancel_order(oid, key, secret)
                log.info(f'    canceled order {oid} ({otype}/{oclass})')
        time.sleep(1)
        tp_price = round(avg_entry * 2.0, 2)  # +100% TP unchanged
        result = submit_oco_close(occ, qty, desired_stop, tp_price, key, secret)
        if result and result.get('id'):
            pct_locked = round((desired_stop / avg_entry - 1) * 100, 1)
            peak_pct = round((peak / avg_entry - 1) * 100, 1)
            log.info(f'    new OCO submitted - stop ${desired_stop:.2f} TP ${tp_price:.2f} ({pct_locked:+.1f}% locked)')
            post_discord(agent, occ,
                f'Trail ratcheted - peak ${peak:.2f} ({peak_pct:+.1f}%)\n'
                f'New stop ${desired_stop:.2f} ({pct_locked:+.1f}% from entry)\n'
                f'TP ${tp_price:.2f} unchanged')
            pos_state['current_stop'] = desired_stop
            pos_state['last_trail_at'] = datetime.now(timezone.utc).isoformat()
        else:
            log.error(f'    OCO submit failed for {occ}')

    pos_state['peak_mark'] = peak
    pos_state['last_check_at'] = datetime.now(timezone.utc).isoformat()
    state[state_key] = pos_state


def main():
    log.info('=== trail cycle ===')
    state = load_state()

    active_keys = set()
    for agent, key_file, secret_file in ACCOUNTS:
        key = core.read_secret(key_file)
        secret = core.read_secret(secret_file)
        if not key or not secret:
            continue
        positions = core.get_open_positions(key, secret)
        if not positions:
            continue
        log.info(f'{agent}: {len(positions)} open position(s)')
        for p in positions:
            try:
                trail_position(agent, key, secret, p, state)
                active_keys.add(f'{agent}_{p.get("symbol")}')
            except Exception as e:
                log.error(f'  {agent} {p.get("symbol")}: {e}')

    # Garbage-collect state entries for closed positions
    state = {k: v for k, v in state.items() if k in active_keys}
    save_state(state)
    log.info('=== done ===')


if __name__ == '__main__':
    main()
