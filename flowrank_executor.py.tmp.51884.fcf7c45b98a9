#!/usr/bin/env python3
"""flowrank_executor.py — Auto-execute top-ranked FlowRank contracts on Alpaca.

Runs every 5 minutes during market hours (via PM2). Checks FlowRank for
contracts ≥75% confidence, validates entry conditions, and places market orders.

Entry guard rails (all must pass):
  1. Confidence ≥ 75% (FlowRank score ≥ 75/100)
  2. Not already in position (check open Boba + Jazzy positions)
  3. Bid-ask spread ≤ 25% of mid (not illiquid)
  4. Current price not >35% above first alert price (don't chase)
  5. Buying power available (≥ $100 minimum order)
  6. Market is open (not pre/after hours)

Routing:
  - Boba (PA34WLDYTCMV): 0-7 DTE CALLS on semis/AI/mega-tech (MU, NVDA, AAPL, META, AMD, PLTR)
  - Jazzy (PA3ST95DAKQ4): 8-30 DTE CALLS + broader sectors (MSFT, ORCL, SNOW, CRM, TSLA, SPX)

Position sizing: 7% of buying_power per account, min 1 contract, max $300 per entry
Stop registration: writes to ~/.openclaw/workspace/state/options_trail_state.json
"""
from __future__ import annotations

import json
import sys
import time
import urllib.request
import urllib.error
from datetime import datetime, timezone
from pathlib import Path

# ── Paths ──────────────────────────────────────────────────────────────────
SEC    = Path.home() / ".openclaw" / "secrets"
STATE  = Path.home() / ".openclaw" / "workspace" / "state" / "options_trail_state.json"
LOG    = Path.home() / "logs" / "flowrank_executor.log"
LOG.parent.mkdir(parents=True, exist_ok=True)
STATE.parent.mkdir(parents=True, exist_ok=True)

ALPACA_BASE = "https://paper-api.alpaca.markets/v2"

# ── Account routing ─────────────────────────────────────────────────────────
# Boba: momentum, short-DTE, AI/semis
BOBA_SYMBOLS  = {"MU", "NVDA", "AAPL", "META", "AMD", "PLTR", "TSLA", "SMH",
                 "SMCI", "AMZN", "GOOGL", "SPX", "SPY", "QQQ"}
BOBA_MAX_DTE  = 7

# Jazzy: medium-DTE, broader tech + sector plays
JAZZY_SYMBOLS = {"MSFT", "ORCL", "SNOW", "CRM", "TSLA", "DELL", "CRM",
                 "NFLX", "AMD", "NVDA", "AAPL", "META", "SPX", "QQQ"}
JAZZY_MAX_DTE = 30

# ── Config ──────────────────────────────────────────────────────────────────
MIN_CONFIDENCE  = 0.75
MAX_SPREAD_PCT  = 0.25    # reject if (ask-bid)/mid > 25%
MAX_CHASE_PCT   = 0.35    # reject if current_ask > alert_price * 1.35
POSITION_PCT    = 0.07    # 7% of buying_power per entry
MIN_ORDER_USD   = 100.0
MAX_ORDER_USD   = 300.0   # cap at $300 on $2K accounts
MARKET_OPEN     = (9, 30)
MARKET_CLOSE    = (16, 0)


def _log(msg: str) -> None:
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    line = f"[{ts}] {msg}"
    print(line, flush=True)
    with LOG.open("a") as f:
        f.write(line + "\n")


def _headers(key_file: str, secret_file: str) -> dict:
    return {
        "APCA-API-KEY-ID":     (SEC / key_file).read_text().strip(),
        "APCA-API-SECRET-KEY": (SEC / secret_file).read_text().strip(),
        "Content-Type":        "application/json",
    }


def _get(url: str, headers: dict) -> dict:
    req = urllib.request.Request(url, headers=headers)
    try:
        return json.loads(urllib.request.urlopen(req, timeout=10).read())
    except Exception as e:
        _log(f"GET {url} failed: {e}")
        return {}


def _post(url: str, headers: dict, payload: dict) -> dict:
    data = json.dumps(payload).encode()
    req = urllib.request.Request(url, data=data, headers=headers, method="POST")
    try:
        return json.loads(urllib.request.urlopen(req, timeout=10).read())
    except urllib.error.HTTPError as e:
        body = e.read().decode()
        _log(f"POST {url} HTTP {e.code}: {body[:200]}")
        return {}
    except Exception as e:
        _log(f"POST {url} error: {e}")
        return {}


def market_is_open() -> bool:
    now = datetime.now(timezone.utc)
    # Simple ET check (UTC-4 during EDT, UTC-5 EST — use UTC-4 as approximation)
    et_hour = (now.hour - 4) % 24
    et_min  = now.minute
    if now.weekday() >= 5:  # weekend
        return False
    after_open  = (et_hour, et_min) >= MARKET_OPEN
    before_close = (et_hour, et_min) < MARKET_CLOSE
    return after_open and before_close


def get_flowrank_top(hours: int = 2, max_dte: int = 30) -> list[dict]:
    """Get current top-ranked contracts from the FlowRank tool."""
    try:
        sys.path.insert(0, str(Path.home() / "04_RESEARCH/integrations/Vibe-Trading/agent"))
        from src.tools.options_flow_rank_tool import OptionsFlowRankTool
        t = OptionsFlowRankTool()
        if not t.check_available():
            _log("FlowRank DB not available")
            return []
        result = json.loads(t.execute(action="rank", hours=hours, max_dte=max_dte,
                                      min_hits=3, formatted=False))
        return [c for c in result.get("top_3", []) if c.get("confidence", 0) >= MIN_CONFIDENCE]
    except Exception as e:
        _log(f"FlowRank error: {e}")
        return []


def get_option_quote(symbol: str, occ: str, headers: dict) -> dict:
    """Get current bid/ask for an option contract."""
    try:
        url = f"https://data.alpaca.markets/v1beta1/options/snapshots/{occ}?feed=indicative"
        req = urllib.request.Request(url, headers=headers)
        data = json.loads(urllib.request.urlopen(req, timeout=8).read())
        snap = data.get("snapshots", {}).get(occ, {})
        q = snap.get("latestQuote", {})
        return {"bid": q.get("bp", 0), "ask": q.get("ap", 0), "mid": (q.get("bp", 0) + q.get("ap", 0)) / 2}
    except Exception:
        return {}


def get_open_positions(headers: dict) -> set[str]:
    """Return set of OCC symbols currently held."""
    positions = _get(f"{ALPACA_BASE}/positions", headers)
    if isinstance(positions, list):
        return {p.get("symbol", "") for p in positions}
    return set()


def build_occ(symbol: str, expiry: str, option_type: str, strike: float) -> str:
    """Build OCC option symbol: AAPL261218C00150000"""
    date_part = expiry.replace("-", "")[2:]  # YYMMDD from YYYY-MM-DD
    opt = "C" if option_type == "CALL" else "P"
    strike_part = str(int(strike * 1000)).zfill(8)
    return f"{symbol.ljust(6)}{date_part}{opt}{strike_part}".replace(" ", "")


def place_order(occ: str, qty: int, headers: dict) -> dict:
    """Place a market buy order for an options contract."""
    payload = {
        "symbol":           occ,
        "qty":              str(qty),
        "side":             "buy",
        "type":             "market",
        "time_in_force":    "day",
        "position_intent":  "buy_to_open",
    }
    return _post(f"{ALPACA_BASE}/orders", headers, payload)


def load_trail_state() -> dict:
    if STATE.exists():
        try:
            return json.loads(STATE.read_text())
        except Exception:
            return {}
    return {}


def save_trail_state(state: dict) -> None:
    STATE.write_text(json.dumps(state, indent=2, default=str))


def register_position(occ: str, entry_price: float, qty: int, dte: int,
                       confidence: float, symbol: str) -> None:
    """Add new position to trailing stop state so the daemon picks it up."""
    state = load_trail_state()
    if occ not in state:
        state[occ] = {
            "entry_price":   entry_price,
            "qty":           qty,
            "dte":           dte,
            "symbol":        symbol,
            "confidence":    confidence,
            "peak_price":    entry_price,
            "peak_pct":      0.0,
            "locked_pct":    -999.0,
            "last_stop":     None,
            "first_seen":    datetime.now(timezone.utc).isoformat(),
            "source":        "flowrank_executor",
        }
        save_trail_state(state)
        _log(f"Registered {occ} in trail state (entry=${entry_price:.2f}, qty={qty}, DTE={dte})")


def process_account(account_name: str, key_file: str, secret_file: str,
                    allowed_symbols: set, max_dte: int, contracts: list[dict]) -> None:
    headers = _headers(key_file, secret_file)
    account = _get(f"{ALPACA_BASE}/account", headers)
    if not account:
        _log(f"{account_name}: cannot reach Alpaca")
        return

    buying_power = float(account.get("buying_power", 0))
    equity       = float(account.get("equity", 0))
    _log(f"{account_name}: equity=${equity:,.0f} bp=${buying_power:,.0f}")

    if buying_power < MIN_ORDER_USD:
        _log(f"{account_name}: buying power too low (${buying_power:.0f} < ${MIN_ORDER_USD:.0f})")
        return

    open_positions = get_open_positions(headers)

    for c in contracts:
        symbol = c["symbol"].upper()
        opt    = c["option_type"]
        strike = float(c["strike"])
        expiry = c["expiry"]
        dte    = c["dte"]
        conf   = c["confidence"]
        hits   = c["hits"]

        # Route check
        if symbol not in allowed_symbols:
            continue
        if dte > max_dte:
            continue

        occ = build_occ(symbol, expiry, opt, strike)

        # Already in position?
        if occ in open_positions:
            _log(f"{account_name}: {occ} already held — skip")
            continue

        # Get current quote
        quote = get_option_quote(symbol, occ, headers)
        if not quote or quote["ask"] <= 0:
            _log(f"{account_name}: {occ} no quote — skip")
            continue

        bid, ask, mid = quote["bid"], quote["ask"], quote["mid"]

        # Spread check
        if mid > 0 and (ask - bid) / mid > MAX_SPREAD_PCT:
            _log(f"{account_name}: {occ} spread too wide ({(ask-bid)/mid*100:.0f}% > {MAX_SPREAD_PCT*100:.0f}%) — skip")
            continue

        # Chase check — compare to flow alert price (first_price from flow_events)
        # We use total_premium / hits as a proxy for average alert price
        alert_price_proxy = c.get("total_premium", 0) / max(hits, 1)
        if alert_price_proxy > 0 and ask > alert_price_proxy * (1 + MAX_CHASE_PCT):
            _log(f"{account_name}: {occ} price chased too far (ask=${ask:.2f} > {(1+MAX_CHASE_PCT)*100:.0f}% of alert) — skip")
            continue

        # Position sizing: 7% of buying power, capped at MAX_ORDER_USD
        order_usd = min(buying_power * POSITION_PCT, MAX_ORDER_USD)
        contracts_to_buy = max(1, int(order_usd / (ask * 100)))  # options are 100x multiplier
        order_cost = contracts_to_buy * ask * 100

        if order_cost > buying_power:
            contracts_to_buy = 1
            order_cost = ask * 100
        if order_cost > buying_power:
            _log(f"{account_name}: {occ} not enough bp (need ${order_cost:.0f} have ${buying_power:.0f}) — skip")
            continue

        _log(f"{account_name}: BUYING {occ} x{contracts_to_buy} @ ask ${ask:.2f} (${order_cost:.0f}) conf={conf:.0%} hits={hits}")

        result = place_order(occ, contracts_to_buy, headers)
        if result.get("id"):
            _log(f"{account_name}: ORDER PLACED {result['id']} status={result.get('status','?')}")
            register_position(occ, ask, contracts_to_buy, dte, conf, symbol)
        else:
            _log(f"{account_name}: ORDER FAILED — {result}")


def main() -> None:
    _log("=== FlowRank Executor starting ===")

    if not market_is_open():
        _log("Market closed — exiting")
        return

    # Get top-ranked contracts (last 2h, prevents re-acting on old alerts)
    contracts = get_flowrank_top(hours=2, max_dte=30)
    _log(f"FlowRank returned {len(contracts)} AUTO-EXECUTE contracts")

    if not contracts:
        _log("No contracts above 75% confidence — done")
        return

    for c in contracts:
        _log(f"  Candidate: {c['symbol']} {c['option_type']} ${c['strike']:.0f} {c['expiry']} "
             f"DTE={c['dte']} score={c['score']:.0f} conf={c['confidence']:.0%} hits={c['hits']}")

    # Process Boba (0-7 DTE, semis/AI)
    process_account("Boba-R2", "alpaca-boba-key-id", "alpaca-boba-secret",
                    BOBA_SYMBOLS, BOBA_MAX_DTE, contracts)

    # Process Jazzy (8-30 DTE, broader)
    process_account("Jazzy", "alpaca-jazzy-key-id", "alpaca-jazzy-secret",
                    JAZZY_SYMBOLS, JAZZY_MAX_DTE, contracts)

    _log("=== FlowRank Executor done ===")


if __name__ == "__main__":
    main()
