#!/usr/bin/env python3
"""
fg_push_relay - registers fake FCM device against stock-signal-72772 project,
subscribes to options_paid2 topic, forwards Magic/Lightning/Multi-Winner pushes
to Discord. Bypasses MacroDroid/phone path entirely.

Project credentials extracted from Flow Greeks 2.2.1 APK strings.xml.
Topic confirmed via app's Report-a-Problem screen (Topics: options_paid2).
"""
import asyncio, json, logging, time, sys, urllib.request
from pathlib import Path
from firebase_messaging import FcmRegisterConfig, FcmPushClient

PROJECT_ID = "stock-signal-72772"
APP_ID = "1:720692415658:android:542531a2b71e747b9c14d3"
API_KEY = "AIzaSyBWseaiEGgAKJEZQOvaxkJyqWzKvEjLqbo"
SENDER_ID = "720692415658"
TOPIC = "options_paid2"

CREDS_FILE = Path("/home/ubuntu/.openclaw/state/fg_push_creds.json")
SECRETS = Path("/home/ubuntu/.openclaw/secrets")

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s",
                    datefmt="%Y-%m-%d %H:%M:%S")
log = logging.getLogger("fg-push")

def load_webhook():
    for name in ["discord_webhook_flow_alerts", "discord-webhook-flow-alerts-fg.txt"]:
        p = SECRETS / name
        if p.exists():
            v = p.read_text().strip()
            if v.startswith("https://"):
                return v
    return None

def save_creds(creds):
    CREDS_FILE.parent.mkdir(parents=True, exist_ok=True)
    CREDS_FILE.write_text(json.dumps(creds))
    log.info(f"creds saved to {CREDS_FILE}")

def load_creds():
    if CREDS_FILE.exists():
        try:
            return json.loads(CREDS_FILE.read_text())
        except Exception:
            return None
    return None

def post_discord(webhook, payload):
    title = payload.get("title") or "(no title)"
    body = payload.get("body") or ""
    data = payload.get("data") or {}
    fields = [{"name": k[:25], "value": str(v)[:200], "inline": True}
              for k, v in list(data.items())[:8]]
    embed = {
        "title": f"FG Push: {title}"[:250],
        "description": body[:1000],
        "color": 0xff9800,
        "fields": fields,
        "footer": {"text": f"FCM topic: {TOPIC}"},
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()),
    }
    req = urllib.request.Request(
        webhook,
        data=json.dumps({"embeds": [embed]}).encode(),
        headers={"Content-Type": "application/json",
                 "User-Agent": "MissionCtrl-fg-push-relay/1.0"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.status in (200, 204)
    except Exception as e:
        log.error(f"discord post failed: {e}")
        return False

def on_notification(obj, notif, data_message):
    """Callback for every received push."""
    title = (notif or {}).get("title") if notif else None
    body = (notif or {}).get("body") if notif else None
    data = getattr(data_message, "data", {}) if data_message else {}
    log.info(f"received: title={title!r} data_keys={list(data.keys())}")
    webhook = load_webhook()
    if webhook:
        post_discord(webhook, {"title": title, "body": body, "data": data})

def subscribe_to_topic(fcm_token):
    """Best-effort topic subscription via IID API. Returns (ok, status_code, body_snippet)."""
    url = f"https://iid.googleapis.com/iid/v1/{fcm_token}/rel/topics/{TOPIC}"
    for auth in [
        f"key={API_KEY}",  # try API key as legacy server key
        f"Bearer {API_KEY}",  # try as bearer
    ]:
        try:
            req = urllib.request.Request(url, method="POST", headers={
                "Authorization": auth,
                "Content-Length": "0",
            })
            with urllib.request.urlopen(req, timeout=10) as r:
                body = r.read()
                log.info(f"topic subscribe with auth={auth[:15]}... -> HTTP {r.status} body={body[:200]!r}")
                return True, r.status, body[:200]
        except urllib.error.HTTPError as e:
            body = e.read()
            log.warning(f"topic subscribe with auth={auth[:15]}... -> HTTP {e.code} body={body[:200]!r}")
        except Exception as e:
            log.warning(f"topic subscribe with auth={auth[:15]}... -> {e}")
    return False, 0, b""

async def main():
    config = FcmRegisterConfig(
        project_id=PROJECT_ID,
        app_id=APP_ID,
        api_key=API_KEY,
        messaging_sender_id=SENDER_ID,
    )
    creds = load_creds()
    if creds:
        log.info("loaded persisted credentials")
    else:
        log.info("no persisted creds, will register fresh")

    pc = FcmPushClient(
        on_notification,
        config,
        credentials=creds,
        credentials_updated_callback=save_creds,
    )

    log.info("checkin or register...")
    fcm_token = await pc.checkin_or_register()
    log.info(f"FCM token (first 40): {fcm_token[:40]}...")

    ok, status, body = subscribe_to_topic(fcm_token)
    if not ok:
        log.error("topic subscribe failed all methods - notifications may not arrive")
        log.error("falling back to listen-only mode in case topic was already subscribed via prior run")

    log.info(f"starting MCS listener for topic '{TOPIC}'...")
    await pc.start()

    while True:
        await asyncio.sleep(300)
        log.info("heartbeat - still listening")

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        log.info("shutdown")
        sys.exit(0)
